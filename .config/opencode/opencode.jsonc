{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "snapshot": true,
  "agents": {
    "plan": {
      // "model": "opencode-go/deepseek-v4-flash-new"
      // "model": "opencode-go/glm-5.2"
      // "model": "opencode-go/qwen3.7-max"
      // "model": "opencode-go/mimo-v2.5"
      "model": "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017#max"
    },
    "build": {
      // "model": "opencode-go/deepseek-v4-flash-new"
      // "model": "opencode-go/mimo-v2.5"
      "model": "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017#low"
    }
  },
  "disabled_providers": [],
  "providers": {
    "deepinfra": {
      "name": "Deep Infra",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.deepinfra.com/v1/openai",
        // Bare key, decrypted by agenix to /run/agenix (see .config/nix/secrets.nix).
        "apiKey": "{file:/run/agenix/opencode-deepinfra}"
      },
      "models": {
        // Keyed by the catalogue id: a shorter alias makes a second model with
        // the same modelID, and Deep Infra's discount (applied by the
        // deepinfra-billed-cost plugin through a model transform) only reaches
        // the catalogue entry. See docs/learnings/2026-10-23-opencode-cost-is-model-price.md.
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "modelID": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
          "name": "DeepSeek V4.1 Flash 1017",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          // `output` here is the per-step reply budget, not the model's ceiling.
          // OpenCode caps it at 256k anyway (OUTPUT_TOKEN_MAX, PR #51962), and
          // on a 1M-context model that reservation puts the request ceiling
          // (75.6%) BELOW the compaction ceiling (85%), so long sessions
          // compact mid-turn or overflow (issue #58463). 64k keeps the request
          // ceiling at 93.9%, above compaction, with room for long reasoning.
          "limit": { "context": 1048576, "output": 64000 },
          // No `cost` here on purpose: a cost in the model definition is merged
          // after the plugin's model transform and would overwrite the
          // discounted price with list. The base price comes from the
          // catalogue, which is also the fail-safe list price.
          "variants": [
            // Deep Infra's own knob. It accepts none|minimal|low|medium|high|xhigh|max
            // even though the docs list only none|low|medium|high.
            //
            // `settings`, not `body`: a raw body overlay is applied after
            // request options, so it would clobber the per-agent effort the
            // agent-model plugin sets on the request.
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    }
  },
  "mcp": {
    "sophrosyne": {
      "type": "remote",
      "url": "http://sophrosyne:8892/sse",
      "enabled": true
    }
  },
  "provider": {
    "sophrosyne": {
      "name": "Sophrosyne",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://sophrosyne.local:8080"
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen 3.6 27B"
        }
      }
    }
  }
}
