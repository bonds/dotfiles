#!/usr/bin/env bash
# nr-pins — manage the self-expiring flake input pins that keep `nr --update`
# building when an input's branch head would force a package to be built from
# source whose own tests fail on this machine — and revert a prebuilt-overlay
# bump whose package is what failed to build.
#
# Invoked by `nr` (see ~/.config/fish/conf.d/15-functions.fish):
#   nr-pins snapshot            before `nix flake update` — remember the revs that built
#   nr-pins check               before `nix flake update` — drop pins no longer needed
#   nr-pins diagnose <logfile>  after a failed build — pin the culprit input (or
#                               revert a bad prebuilt-overlay bump), then retry
#   nr-pins verify <system>     after a SUCCESSFUL build — smoke-test the built
#                               prebuilt packages, revert a bad bump, retry
#   nr-pins list                show the registry
#   nr-pins apply               re-render the pin block in flake.nix from the registry
#
# The registry (flake-pins.json) is the source of truth; the delimited block in
# flake.nix is generated from it. A pin is justified while the input's branch
# head would still have to BUILD the named packages; `check` drops it as soon as
# a substituter carries them again.
#
# The block ALWAYS declares every input it owns — the registry's `base` list —
# emitting the pinned rev URL when a pin exists for that input and its normal
# branch URL otherwise. A pin must never be the only thing declaring an input:
# the rest of flake.nix follows nixpkgs / nixpkgs-unstable by name, so dropping
# the last pin used to delete their declarations, making every
# `inputs.X.follows = "nixpkgs"` dangle — `nix flake update` then failed hard
# with "input 'agenix/nixpkgs' follows a non-existent input 'nixpkgs'".
# Invariant, enforced fail-closed in reg_init BEFORE anything is written: every
# `inputs.X.follows = "Y"` in flake.nix must name an input the resulting flake
# declares — either in this block (the registry's `base` list, plus any pin) or
# elsewhere in flake.nix. `base` must therefore list every input the block owns;
# a base that is non-empty but omits a followed input is refused loudly, not
# rendered (that omission IS the original bug). `base` itself is optional and
# defaults to the two nixpkgs inputs, so a bare {"pins": []} registry still
# renders a valid block.
#
# Two mechanisms, both driven by `diagnose`:
#
#   * flake input pins — the registry below; a pin freezes an input at the last
#     rev that built and expires on its own;
#   * prebuilt-overlay reverts — `nr --update`'s update.sh scripts bump a version
#     + SRI hash in modules/overlays/* and a few pkgs/*, which are NOT flake
#     inputs. When the failing derivation is one of those packages, diagnose
#     restores the directory from git instead: the last committed pin. See
#     "overlay pins" below.
#   * prebuilt-overlay smoke tests — a build can succeed and the package still be
#     broken at runtime (won't start, wrong version, broken code signature, a
#     config schema the new binary rejects). `verify` runs each overlay's
#     optional verify.sh against the freshly built store path, before `nr`
#     switches to it, and reverts the same way on failure.
#
# Exit codes: 0 = nothing to do · 2 = registry/flake.nix rewritten (a pin) ·
# 3 = a prebuilt-overlay bump was reverted (no registry change) · 1 = pins
# remain, or nothing could be pinned/reverted.

set -uo pipefail

FLAKE_DIR="${NR_PINS_FLAKE_DIR:-$HOME/.config/nix}"
FLAKE_NIX="$FLAKE_DIR/flake.nix"
LOCK="$FLAKE_DIR/flake.lock"
REGISTRY="$FLAKE_DIR/flake-pins.json"
SNAPSHOT="${NR_PINS_SNAPSHOT:-$HOME/.cache/nr/pins-snapshot.json}"
BEGIN_MARK="BEGIN nr-managed input pins"
END_MARK="END nr-managed input pins"

die() { printf 'nr-pins: %s\n' "$*" >&2; exit 1; }
log() { printf 'nr-pins: %s\n' "$*"; }

# ------------------------------------------------------------------ registry --

reg_init() {
    # Fail closed on an unreadable registry. Without this a corrupt file makes
    # reg_inputs emit nothing, every per-entry guard never runs, and `check`
    # reports the benign "no pins" success while pins that ARE in flake.nix go
    # unprobed — a failure read as the clean default. Every command calls this.
    if [ ! -f "$REGISTRY" ]; then
        mkdir -p "$(dirname "$REGISTRY")" || die "cannot create $(dirname "$REGISTRY")"
        printf '{\n  "pins": []\n}\n' > "$REGISTRY" || die "cannot initialise $REGISTRY"
        return 0
    fi
    # Syntax, shape, AND field completeness. A pin missing url/branch would
    # otherwise render `nixpkgs.url = "";` straight into flake.nix, and a
    # complete-record failure must fail closed for EVERY command, not just the
    # one that happens to probe it. The character classes are the second half of
    # that guarantee: input/branch/url/since are interpolated verbatim into
    # flake.nix, so a hand-edited value containing whitespace, a quote, or a
    # newline could break the line or inject one. They are anchored with \z, not
    # `$`, because `$` matches before a trailing newline. reason is free text —
    # it is safe because it is emitted with a per-line comment prefix — and pnames
    # members are deliberately not checked: `check` keeps the pin when it cannot
    # read them.
    jq -e '
        (.pins | type) == "array"
        and all(.pins[];
            (.input | type) == "string" and (.input | length) > 0
            and (.input | test("^[A-Za-z0-9._-]+\\z"))
            and (.branch | type) == "string" and (.branch | length) > 0
            and (.branch | test("^[A-Za-z0-9._:/@+?=&-]+\\z"))
            and (.url | type) == "string" and (.url | length) > 0
            and (.url | test("^[A-Za-z0-9._:/@+?=&-]+\\z"))
            and (.pnames | type) == "array"
            and (.since | type) == "string" and (.since | length) > 0
            and (.since | test("^[A-Za-z0-9._-]+\\z"))
            and (.reason | type) == "string" and (.reason | length) > 0
        )
        and ((.pins | map(.input) | unique | length) == (.pins | length))
        and (if has("base") then
                 (.base | type) == "array" and (.base | length) > 0
                 and all(.base[];
                     (.input | type) == "string" and (.input | length) > 0
                     and (.input | test("^[A-Za-z0-9._-]+\\z"))
                     and (.url | type) == "string" and (.url | length) > 0
                     and (.url | test("^[A-Za-z0-9._:/@+?=&-]+\\z"))
                     # Optional, for rev-pinned inputs: the package names its
                     # build produces, so `diagnose` can attribute a failing
                     # derivation to it, and a free-text note rendered in the
                     # block (comment-prefixed, so it is safe like `reason`).
                     and (if has("pnames") then
                              (.pnames | type) == "array"
                              and all(.pnames[]; (. | type) == "string" and test("^[A-Za-z0-9._+-]+\\z"))
                          else true end)
                     and (if has("note") then (.note | type) == "string" else true end)
                 )
                 and ((.base | map(.input) | unique | length) == (.base | length))
             else true end)' "$REGISTRY" > /dev/null 2>&1 \
        || die "the pin registry $REGISTRY is unreadable, has no 'pins' array, or has an invalid entry — input/branch/url/since must be non-empty and free of whitespace, quotes or newlines; reason must be non-empty (free text, emitted as a comment); pnames must be an array; input names must be unique within 'pins' and within 'base'; when present, 'base' must be a NON-EMPTY array of {input,url} obeying the same input/url rules"

    # A pin may only overlay an input the base list already owns: otherwise
    # dropping the pin would delete the input's declaration.
    local owned input target declared
    owned=" $(reg_base | cut -f1 | tr '\n' ' ') "
    for input in $(reg_inputs); do
        case "$owned" in
            *" $input "*) ;;
            *) die "the registry pins '$input' but its base list does not declare it — add {\"input\": \"$input\", \"url\": \"github:<owner>/<repo>/<branch>\"} to .base so the generated block always declares it" ;;
        esac
    done

    # The real invariant (the one the bug violated): every `follows` target named
    # in flake.nix must be an input the resulting flake declares — either in the
    # generated block (base ∪ pins) or elsewhere in flake.nix (e.g. flake-parts).
    # Checked here, before any write, so an incomplete `base` is refused loudly
    # instead of silently re-rendering a flake whose follows targets dangle.
    declared=" $(declared_inputs | tr '\n' ' ') "
    for target in $(follows_targets); do
        case "$declared" in
            *" $target "*) ;;
            *) die "flake.nix follows '$target' but neither the generated pin block (base ∪ pins) nor the rest of flake.nix declares it — add {\"input\": \"$target\", \"url\": \"github:<owner>/<repo>/<branch>\"} to .base" ;;
        esac
    done
}

follows_targets() { # → every distinct `follows = "X"` target named in flake.nix
    grep -oE 'follows[[:space:]]*=[[:space:]]*"[^"]+"' "$FLAKE_NIX" 2> /dev/null \
        | sed -E 's/.*"([^"]+)"$/\1/' | LC_ALL=C sort -u
}

declared_inputs() { # → every input name the rendered flake.nix will declare
    # The block's inputs (base ∪ pins) plus whatever flake.nix declares OUTSIDE the
    # block (flake-parts lives there). Used to prove every follows target resolves.
    {
        reg_base | cut -f1
        reg_inputs
        sed -n '/BEGIN nr-managed input pins/,/END nr-managed input pins/!p' "$FLAKE_NIX" 2> /dev/null \
            | grep -oE '^[[:space:]]*[A-Za-z0-9._-]+([[:space:]]*\.url[[:space:]]*=|([[:space:]]*=[[:space:]]*\{))' \
            | sed -E 's/^[[:space:]]*//; s/[[:space:]]*[.=].*$//'
    } | LC_ALL=C sort -u
}

reg_inputs() { jq -r '.pins[]? | .input' "$REGISTRY"; }

reg_base_add() { # reg_base_add <input> <branch-url> — make sure .base covers <input>
    # Used by `diagnose` when it pins an input the registry's base list omits.
    # Without this the pin would be written and then refused by every later
    # command, leaving an unusable registry. Materialises the current base (which
    # may be the built-in default) before appending.
    local i="$1" u="$2" tmp
    reg_base | cut -f1 | grep -qxF "$i" && return 0
    tmp="$(mktemp)" || return 1
    if jq --arg i "$i" --arg u "$u" \
        --argjson b "$(reg_base | jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | {input: .[0], url: .[1]})')" \
        '.base = ($b + [{input: $i, url: $u}])' "$REGISTRY" > "$tmp"; then
        mv "$tmp" "$REGISTRY" && return 0
    fi
    rm -f "$tmp"
    return 1
}

reg_base() { # → "input<TAB>normal-branch-url", one line per owned input
    # The inputs the generated block owns and ALWAYS declares. With no `base`
    # list, default to the two nixpkgs inputs the pin mechanism manages — which
    # is exactly what every earlier registry implied, so the broken on-disk
    # {"pins": []} state still renders a valid block with no hand-editing.
    if jq -e 'has("base")' "$REGISTRY" > /dev/null 2>&1; then
        jq -r '.base[] | "\(.input)\t\(.url)"' "$REGISTRY"
    else
        printf 'nixpkgs\tgithub:NixOS/nixpkgs/nixos-26.05\n'
        printf 'nixpkgs-unstable\tgithub:NixOS/nixpkgs/nixpkgs-unstable\n'
    fi
}

reg_base_url() { # reg_base_url <input> → its normal URL (branch, or rev for rev-pinned)
    reg_base | awk -F'\t' -v i="$1" '$1 == i {print $2; exit}'
}

reg_base_pnames() { # reg_base_pnames <input> → declared package names (may be empty)
    jq -r --arg i "$1" '.base[]? | select(.input == $i) | (.pnames // [])[]' "$REGISTRY" 2> /dev/null
}

reg_base_note() { # reg_base_note <input> → free-text note for the block (may be empty)
    jq -r --arg i "$1" '.base[]? | select(.input == $i) | .note // empty' "$REGISTRY" 2> /dev/null
}

# A rev-pinned input is a third-party flake input locked to a release rev rather
# than a branch (e.g. `git+https://github.com/owner/repo?rev=<sha>`). Its base
# URL changes when a new release is published, so it cannot be probed against a
# branch the way a nixpkgs pin is. `check` and `diagnose` handle it by URL
# comparison and by matching the failing derivation's package name instead.
is_rev_input() {
    case "$(reg_base_url "$1")" in
        *'?rev='* | *'&rev='*) return 0 ;;
    esac
    return 1
}

rev_inputs() { # → every rev-pinned input the registry's base owns
    reg_base | cut -f1 | while IFS= read -r i; do
        [ -n "$i" ] || continue
        is_rev_input "$i" && printf '%s\n' "$i"
    done
}

rev_pin_url() { # rev_pin_url <input> <rev> → its base URL with the rev replaced
    reg_base_url "$1" | sed -E "s/([?&]rev=)[0-9a-f]+/\1$2/"
}

reg_get() { # reg_get <input> <field>
    jq -r --arg i "$1" --arg f "$2" \
        '.pins[]? | select(.input == $i) | .[$f] | if type == "array" then join(", ") else (. // "") end' \
        "$REGISTRY"
}

reg_pnames() { # reg_pnames <input> → package names; NON-ZERO when none or unextractable
    # -e makes jq exit non-zero when the entry has no pnames, or when .pnames is
    # null and cannot be iterated. Callers must treat that as "cannot probe",
    # never as "the blocker cleared" — an unreadable entry is not evidence.
    jq -er --arg i "$1" '.pins[]? | select(.input == $i) | .pnames[]' "$REGISTRY" 2> /dev/null
}

reg_put() { # reg_put <json-object>
    local tmp
    tmp="$(mktemp)" || return 1
    if jq --argjson o "$1" '.pins = (((.pins // []) | map(select(.input != $o.input))) + [$o])' \
        "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

reg_drop() { # reg_drop <input>
    local tmp
    tmp="$(mktemp)" || return 1
    if jq --arg i "$1" '.pins = ((.pins // []) | map(select(.input != $i)))' \
        "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# ---------------------------------------------------------------- flake.lock --

lock_field() { jq -r --arg n "$1" --arg f "$2" '.nodes[$n].locked[$f] // empty' "$LOCK"; }
lock_rev() { lock_field "$1" rev; }

# Inputs that come from nixpkgs (owner NixOS, repo nixpkgs) are the only ones
# `diagnose` is allowed to pin on its own. Never your own inputs: freezing those
# would hide your own breakage instead of surfacing it.
nixpkgs_inputs() {
    # Prefer the inputs DECLARED in flake.nix's `inputs` — `.nodes.root.inputs`
    # maps each declared input name to its lock node. Scanning every node with
    # owner=NixOS/repo=nixpkgs would also catch internal nodes that merely
    # `follows` one of them (a second nixpkgs node under another name), and
    # `--override-input` cannot name those.
    #
    # Fall back to the full scan if the lock has no `root` entry, but say so on
    # stderr: silently returning an empty list would leave diagnose unable to
    # pin anything while still reporting a clean verdict.
    local in node
    if jq -e '.nodes.root.inputs? // empty' "$LOCK" > /dev/null 2>&1; then
        jq -r '.nodes.root.inputs | to_entries[] | "\(.key) \(.value)"' "$LOCK" 2> /dev/null \
            | while read -r in node; do
                [ "$(lock_field "$node" owner)" = NixOS ] \
                    && [ "$(lock_field "$node" repo)" = nixpkgs ] \
                    && printf '%s\n' "$in"
            done | sort
        return 0
    fi
    log "flake.lock has no nodes.root.inputs — falling back to scanning every node (an internal 'follows' node may be unpinnable)" >&2
    jq -r '.nodes | to_entries[] | select(.value.locked.owner == "NixOS" and .value.locked.repo == "nixpkgs") | .key' \
        "$LOCK" 2> /dev/null | sort
}

branch_url() { # branch_url <input> → the input's normal branch URL, or empty
    local ref owner repo
    # Prefer the registry's `base` list: it holds each owned input's normal
    # branch URL — the same URL render_block emits while no pin is active, and
    # the same one `check` probes. The lock is NOT a reliable source here:
    # `.locked.ref` is absent whenever the input was locked BY REV, which is
    # exactly the state an active pin leaves behind, so reading the lock alone
    # made every `diagnose` probe bail out with "no branch ref in flake.lock"
    # and nothing was ever pinned back.
    ref="$(reg_base | awk -F'\t' -v i="$1" '$1 == i {print $2; exit}')"
    if [ -n "$ref" ]; then printf '%s\n' "$ref"; return 0; fi
    # Fallback for an input the registry does not own: the lock's own ref —
    # `original.ref` is the declared ref, `locked.ref` the resolved one.
    ref="$(jq -r --arg n "$1" '.nodes[$n].original.ref // .nodes[$n].locked.ref // empty' "$LOCK" 2>/dev/null)"
    owner="$(lock_field "$1" owner)"; repo="$(lock_field "$1" repo)"
    [ -n "$ref" ] && [ -n "$owner" ] && [ -n "$repo" ] && printf 'github:%s/%s/%s\n' "$owner" "$repo" "$ref"
}

pin_url() { # pin_url <input> <rev> → github:owner/repo/<rev>
    printf 'github:%s/%s/%s\n' "$(lock_field "$1" owner)" "$(lock_field "$1" repo)" "$2"
}

moved() { # moved <input> → true if its rev differs from the snapshot
    local before now
    before="$(jq -r --arg n "$1" '.nodes[$n].locked.rev // empty' "$SNAPSHOT" 2>/dev/null)"
    now="$(lock_rev "$1")"
    [ -n "$before" ] && [ "$before" != "$now" ]
}

rescape() { printf '%s' "$1" | sed 's/[][\\.^$*+?(){}|]/\\&/g'; }

# nh (nix-output-monitor) colours the store path INSIDE the quotes of its
# "builder for '<path>' failed" line, and `nr` tees nh's output into the logfile
# `diagnose` is handed:
#
#     error: builder for '\e[35;1m/nix/store/<hash>-<name>.drv\e[0m' failed ...
#
# A literal grep for "builder for '/nix/store/..." therefore never matches an nh
# log, every failure reads as "no failing derivation (eval error?)", and nothing
# is ever pinned — the self-healing half of the pin mechanism is dead. Strip
# CSI (ESC [ params intermediates final) and OSC (ESC ] ... BEL) sequences
# before parsing.
strip_ansi() {
    sed -e $'s/\x1b\][^\x07]*\x07//g' \
        -e $'s/\x1b\[[0-9:;<=>?]*[ -/]*[@-~]//g'
}

# -------------------------------------------------------------- overlay pins --
# `nr --update` also bumps hand-pinned prebuilt packages: every directory under
# modules/overlays/ and the prebuilt pkgs/ that carries a default.nix plus the
# update.sh rewriting its version + SRI hash (sometimes a sources.json). Those
# are not flake inputs, so neither a rev pin nor the nixpkgs probe applies to
# them — but the same self-healing rule does. When the failing derivation is one
# of the packages such a bump produced, restore the directory from git (the last
# committed pin) and let `nr` rebuild: the bad bump never reaches a commit, and
# the next `nr --update` tries the newest release again.
#
# Deliberately not registry entries: the registry renders flake.nix input
# declarations, and these packages are not inputs. Reverting a file is also
# inherently self-expiring — the next update.sh run bumps it again.
DOT_GIT_DIR="${NR_PINS_GIT_DIR:-$HOME/.local/share/dotfiles}"
DOT_WORK_TREE="${NR_PINS_WORK_TREE:-$HOME}"

# A changed line that is only a pin. Loose on purpose in one direction only: a
# line that does not match keeps the directory from being reverted.
PIN_LINE_RE='^[+-][[:space:]]*"?(version|hash|sha256|sri|rev|integrity)"?[[:space:]]*[:=]|^[+-][[:space:]]*[A-Za-z_][A-Za-z0-9_]*(Version|Hash|Rev|Sha256|Integrity)[[:space:]]*[:=]'

dot_git() { # dot_git <git args...> — the dotfiles repo, with the work tree as cwd
    ( cd "$DOT_WORK_TREE" 2> /dev/null \
        && git --git-dir="$DOT_GIT_DIR" --work-tree="$DOT_WORK_TREE" "$@" )
}

overlay_dirs() { # → dirs, relative to the flake dir, that `nr --update` bumps
    local d rel
    for d in "$FLAKE_DIR"/modules/overlays/*/ "$FLAKE_DIR"/pkgs/*/; do
        [ -d "$d" ] || continue
        [ -f "$d/default.nix" ] && [ -f "$d/update.sh" ] || continue
        rel="${d%/}"
        rel="${rel#"$FLAKE_DIR"/}"
        # A rev-pinned flake input's directory (pkgs/pi) is reverted through the
        # registry: its pin is an input declaration in flake.nix, and its
        # update.sh edits the registry rather than a hash.
        is_rev_input "${rel##*/}" && continue
        printf '%s\n' "$rel"
    done
}

overlay_pnames() { # overlay_pnames <dir> → the package names its default.nix declares
    grep -oE 'pname[[:space:]]*=[[:space:]]*"[^"]+"' "$FLAKE_DIR/$1/default.nix" 2> /dev/null \
        | sed -E 's/.*"([^"]+)"$/\1/' | LC_ALL=C sort -u
}

overlay_relpath() { # overlay_relpath <dir> → path relative to the git work tree
    case "$FLAKE_DIR" in
        "$DOT_WORK_TREE") printf '%s\n' "$1" ;;
        "$DOT_WORK_TREE"/*) printf '%s/%s\n' "${FLAKE_DIR#"$DOT_WORK_TREE"/}" "$1" ;;
        *) return 1 ;;
    esac
}

overlay_changes() { # overlay_changes <relpath> → its uncommitted files; rc 1 = git failed
    dot_git status --porcelain --untracked-files=no -- "$1" 2> /dev/null
}

overlay_diff_is_pin_only() { # → 0 when EVERY changed line is a version/hash pin
    # Reverting throws the working-tree edit away, so refuse unless the whole
    # diff is a version/hash bump. A hand edit in the same directory therefore
    # survives, and the failure falls through to the input logic below instead
    # of being "reverted" away.
    local rel="$1" nonpin
    nonpin="$(dot_git diff -U0 -- "$rel" 2> /dev/null \
        | grep -E '^[+-]' \
        | grep -vE '^(---|\+\+\+)' \
        | grep -vE '^[+-][[:space:]]*$' \
        | grep -vE "$PIN_LINE_RE")"
    [ -z "$nonpin" ]
}

revert_overlay() { # revert_overlay <dir> → 0 reverted · 1 not a bump of this run · 2 could not    local dir="$1" rel changed files
    rel="$(overlay_relpath "$dir")" || {
        log "cannot revert $dir — the flake dir is not inside the git work tree ($DOT_WORK_TREE)"
        return 2
    }
    command -v git > /dev/null 2>&1 || {
        log "cannot revert $rel — git is not available"
        return 2
    }
    changed="$(overlay_changes "$rel")" || {
        log "cannot revert $rel — git could not report its state"
        return 2
    }
    # Not modified means the failing build is not this run's bump (a nixpkgs
    # regression, or a pin that was committed earlier): nothing to undo here.
    [ -n "$changed" ] || return 1
    if ! overlay_diff_is_pin_only "$rel"; then
        log "$rel has changes that are not a version/hash bump — not reverting it"
        return 1
    fi
    files="$(printf '%s\n' "$changed" | awk '{print $NF}' | paste -sd, -)"
    if dot_git checkout HEAD -- "$rel" 2> /dev/null; then
        log "reverted $files to the last committed pin"
        return 0
    fi
    log "could not revert $rel — git checkout failed; fix the bump by hand"
    return 2
}

# --------------------------------------------------------------------- probe --

# A whole-system dry run with ONE input overridden to a ref. Nix lists a
# derivation only when no substituter carries it — exactly the condition under
# which a blocker bites — and doing it at the system level means no per-package
# attribute path is needed. NR_PINS_PROBE_STUB overrides the command for tests.
probe() { # probe <input> <ref> <attr>
    if [ -n "${NR_PINS_PROBE_STUB:-}" ]; then
        # Propagate the stub's status. A stub can fail on purpose, and the
        # caller must be able to tell that from "nothing to build" — forcing 0
        # here is what made the error path untestable.
        "$NR_PINS_PROBE_STUB" "$1" "$2" "$3"
        return $?
    fi
    # --refresh: never reuse nix's tarball-ttl-cached branch→rev row. Without it
    # the dry run can be made at a rev `nix flake update` never goes on to use,
    # so `check` drops a pin whose blocker has not actually cleared.
    (cd "$FLAKE_DIR" && nix build --dry-run --refresh --no-link --override-input "$1" "$2" ".#$3" 2>&1)
}

needs_build() { # needs_build <input> <ref> <attr> <pname> → 0 built · 1 not built · 2 probe failed
    local out p st
    out="$(probe "$1" "$2" "$3")"
    st=$?
    # A probe that could not run at all (offline, unevaluable ref, hash
    # mismatch) is a THIRD outcome and must never be read as "the blocker
    # cleared": the caller keeps the pin. Collapsing it into the not-built case
    # is how a transient failure would silently unpin the very input the pin
    # exists to hold back — the failure mode this whole tool is meant to avoid.
    [ "$st" -ne 0 ] && return 2
    p="$(rescape "$4")"
    # Each built line looks like "  /nix/store/<hash>-<name>.drv". Match the
    # package name as a whole dash-delimited component, so `anyio` matches
    # python3.12-anyio-4.14.2 while a short name cannot match a longer one.
    printf '%s\n' "$out" \
        | sed -n 's#^.*/nix/store/[a-z0-9]*-\(.*\)\.drv$#\1#p' \
        | grep -qE "(^|-)${p}(-|\$)" && return 0
    return 1
}

drv_pname() { # drv_pname <drv-path>
    local p
    p="$(nix derivation show "$1" 2>/dev/null | jq -r 'to_entries[0].value.env.pname // empty')"
    if [ -z "$p" ]; then
        # Fallback heuristic for a drv whose env is unavailable: strip the store
        # hash and the trailing version, then take the last word. Imperfect for
        # multi-word pnames (arrow-cpp → cpp), but the probe matches on a
        # substring of the real drv name, so a shorter word still hits.
        p="$(basename "$1" .drv | sed -E 's/^[a-z0-9]{32}-//; s/-[0-9][^-]*$//')"
        p="${p##*-}"
    fi
    printf '%s' "$p"
}

resolve_attr() { # resolve_attr → e.g. darwinConfigurations.accismus.system
    [ -n "${NR_PINS_ATTR:-}" ] && { printf '%s\n' "$NR_PINS_ATTR"; return 0; }
    local kind out n
    for kind in darwinConfigurations nixosConfigurations; do
        out="$(cd "$FLAKE_DIR" && nix eval --json --apply 'builtins.attrNames' ".#$kind" 2>/dev/null)" || continue
        n="$(printf '%s' "$out" | jq -r 'if length == 1 then .[0] else empty end')"
        [ -n "$n" ] && { printf '%s.%s.system\n' "$kind" "$n"; return 0; }
    done
    return 1
}

# ------------------------------------------------------------- flake.nix block --

render_block() {
    printf '    # ---- %s ---------------------------------------------\n' "$BEGIN_MARK"
    cat <<'HDR'
    # Generated by `nr` (see .config/nix/nr-pins) — do not hand-edit this block.
    # Edit the registry at .config/nix/flake-pins.json instead.
HDR
    printf '    #\n'
    cat <<'HDR2'
    # Every input this block owns is declared below: the pinned rev URL while a
    # pin is active, its normal branch URL otherwise. A pin freezes an input at
    # the last rev that built, because that input's branch head would need a
    # package built from source whose own tests fail here. `nr --update` probes
    # every pin against its branch head before updating (a whole-system
    # `nix build --dry-run` with that input overridden) and drops the pin as
    # soon as a substituter carries the package again. Dropping a pin must never
    # remove the declaration itself — the rest of flake.nix follows these inputs
    # by name, so a missing declaration makes every `inputs.X.follows` dangle.
HDR2
    local input url branch since reason pnames base_url note
    # Deterministic order (C collation) so reconcile_block's whitespace-normalised
    # diff stays meaningful. reg_inputs is a subset of reg_base (enforced in
    # reg_init); the union keeps the render correct even if that is bypassed.
    {
        reg_base | cut -f1
        reg_inputs
    } | LC_ALL=C sort -u | while IFS= read -r input; do
        [ -n "$input" ] || continue
        url="$(reg_get "$input" url)"
        if [ -n "$url" ]; then
            branch="$(reg_get "$input" branch)"
            since="$(reg_get "$input" since)"
            reason="$(reg_get "$input" reason)"
            pnames="$(reg_pnames "$input" | paste -sd, -)"
            printf '    #\n'
            printf '    # %s — pinned %s, normally %s\n' "$input" "$since" "${branch#github:NixOS/nixpkgs/}"
            [ -n "$pnames" ] && printf '    #   (%s)\n' "$pnames"
            printf '%s\n' "$reason" | fold -s -w 68 | sed -e 's/[[:space:]]*$//' -e 's/^/    #   /'
            printf '    %s.url = "%s";\n' "$input" "$url"
        else
            base_url="$(reg_base_url "$input")"
            [ -n "$base_url" ] || die "the block must declare '$input' but the registry's base list has no URL for it — add {\"input\": \"$input\", \"url\": ...} to .base"
            printf '    #\n'
            printf '    # %s — not pinned, normally %s\n' "$input" "${base_url#github:NixOS/nixpkgs/}"
            note="$(reg_base_note "$input")"
            [ -n "$note" ] && printf '%s\n' "$note" | fold -s -w 68 | sed -e 's/[[:space:]]*$//' -e 's/^/    #   /'
            printf '    %s.url = "%s";\n' "$input" "$base_url"
        fi
    done
    printf '    # ---- %s -----------------------------------------------\n' "$END_MARK"
}

apply_block() { # splice the rendered block into flake.nix (insert or replace)
    local blk tmp nbeg nend orig_lines new_lines old_block
    blk="$(mktemp)" || return 1
    tmp="$(mktemp)" || { rm -f "$blk"; return 1; }
    render_block > "$blk" || { rm -f "$blk" "$tmp"; return 1; }

    # Refuse unless the markers are exactly balanced. Deciding on the BEGIN
    # marker alone is how a file whose END marker went missing gets silently
    # truncated: the awk would skip from BEGIN to EOF, and the remains would be
    # mv'd over flake.nix. A duplicated block is refused for the same reason.
    nbeg="$(grep -cF "$BEGIN_MARK" "$FLAKE_NIX" || true)"
    nend="$(grep -cF "$END_MARK" "$FLAKE_NIX" || true)"
    if [ "$nbeg" -ne "$nend" ] || [ "$nbeg" -gt 1 ]; then
        rm -f "$blk" "$tmp"
        die "flake.nix has $nbeg BEGIN / $nend END marker(s) — refusing to rewrite it; repair the block by hand"
    fi

    if [ "$nbeg" -eq 1 ]; then
        awk -v b="$blk" '
            $0 ~ /BEGIN nr-managed input pins/ { while ((getline l < b) > 0) print l; close(b); inblk = 1; next }
            $0 ~ /END nr-managed input pins/   { inblk = 0; next }
            !inblk                             { print }
        ' "$FLAKE_NIX" > "$tmp"
    else
        awk -v b="$blk" '
            { print
              if (!done && $0 ~ /^[[:space:]]*inputs[[:space:]]*=[[:space:]]*\{/) {
                  while ((getline l < b) > 0) print l
                  close(b); done = 1
              }
            }
            END { exit (done ? 0 : 3) }
        ' "$FLAKE_NIX" > "$tmp"
        if [ $? -eq 3 ]; then
            rm -f "$blk" "$tmp"
            die "no 'inputs = {' line in flake.nix — refusing to insert the pin block"
        fi
    fi

    # Never mv over flake.nix unless the result still looks like the whole file.
    # The only lines legitimately removed are the old block's, so compare against
    # that rather than a fixed slack — a large block can shrink a lot at once.
    orig_lines="$(wc -l < "$FLAKE_NIX")"
    new_lines="$(wc -l < "$tmp")"
    old_block="$(awk '/BEGIN nr-managed input pins/,/END nr-managed input pins/' "$FLAKE_NIX" | wc -l)"
    if [ ! -s "$tmp" ] \
        || [ "$new_lines" -lt $((orig_lines - old_block - 5)) ] \
        || [ "$(grep -cF "$BEGIN_MARK" "$tmp" || true)" -ne 1 ] \
        || [ "$(grep -cF "$END_MARK" "$tmp" || true)" -ne 1 ]; then
        rm -f "$blk" "$tmp"
        die "refusing to write flake.nix — the rendered result failed its sanity check ($orig_lines lines → $new_lines, old block $old_block)"
    fi
    if command -v nix-instantiate > /dev/null 2>&1; then
        nix-instantiate --parse "$tmp" > /dev/null 2>&1 || {
            rm -f "$blk" "$tmp"
            die "refusing to write flake.nix — the rendered result does not parse"
        }
    fi

    # Keep the pre-rewrite copy OUT of $HOME: the flake dir is a tracked worktree
    # (untracked files are hidden by status.showUntrackedFiles=no), so a .bak left
    # beside flake.nix is silent litter that a broad `git add` could stage. Best
    # effort — a missing backup must never block the rewrite.
    mkdir -p "${SNAPSHOT%/*}" 2> /dev/null || true
    cp -f "$FLAKE_NIX" "${SNAPSHOT%/*}/flake.nix.bak" 2> /dev/null || true
    if mv "$tmp" "$FLAKE_NIX"; then
        rm -f "$blk"
        log "rendered the pin block from the registry"
    else
        rm -f "$blk" "$tmp"
        die "could not replace flake.nix — previous copy left at ${SNAPSHOT%/*}/flake.nix.bak"
    fi
}

# ------------------------------------------------------------------ commands --

cmd_snapshot() {
    # Atomic: a failed read must leave the PREVIOUS snapshot intact. Writing
    # straight into $SNAPSHOT truncates it before jq runs, so a transient
    # failure to read flake.lock would destroy the last-good baseline — after
    # which `moved` reports nothing as moved and diagnose can never pin again.
    local dir tmp
    dir="$(dirname "$SNAPSHOT")"
    mkdir -p "$dir" || die "cannot create $dir"
    tmp="$(mktemp "$dir/.pins-snapshot.XXXXXX")" || die "cannot create a temp file in $dir"
    # Validate BEFORE writing: `jq -e '{nodes: .nodes}'` would pass on a lock
    # that has no .nodes, because -e tests the output object, not the field.
    if ! jq -e '.nodes' "$LOCK" > /dev/null 2>&1; then
        rm -f "$tmp"
        die "could not read $LOCK (or it has no .nodes) — previous snapshot left intact"
    fi
    if ! jq '{nodes: .nodes}' "$LOCK" > "$tmp"; then
        rm -f "$tmp"
        die "could not write the snapshot — previous one left intact"
    fi
    mv "$tmp" "$SNAPSHOT" || { rm -f "$tmp"; die "could not replace $SNAPSHOT"; }
    log "snapshotted input revs to $SNAPSHOT"
}

reconcile_block() { # 0 = already matches · 2 = rewritten to match · 1 = cannot be fixed
    # The registry is the source of truth for the generated block, so flake.nix
    # must always match it. Compare whitespace-normalised (the renderer and the
    # splice can differ in trailing space or blank lines) and re-apply when they
    # differ — otherwise an empty registry beside real pin lines reads as the
    # benign "nothing to do". Callers use the return value to decide whether
    # anything changed, so the block is rewritten at most once per run.
    if diff -q <(render_block | sed -e 's/[[:space:]]*$//' -e '/^$/d') \
        <(awk "/$BEGIN_MARK/,/$END_MARK/" "$FLAKE_NIX" | sed -e 's/[[:space:]]*$//' -e '/^$/d') > /dev/null 2>&1; then
        return 0
    fi
    apply_block || return 1
    return 2
}

cmd_check() { # drop every pin whose blocker has cleared
    reg_init
    local attr input branch p pnames pnames_flat still probe_err changed=0 kept=0 base_url
    attr="${1:-}"
    [ -n "$attr" ] || attr="$(resolve_attr)" || die "could not resolve the system attribute to probe"
    for input in $(reg_inputs); do
        branch="$(reg_get "$input" branch)"
        # A rev-pinned input cannot be probed against a branch: its "normal" URL
        # is the release rev the update script set. Keep the pin while the
        # registry still points at the release that failed, and drop it as soon
        # as a newer release appears so `nix flake update` tries that one. The
        # pin's `branch` field holds the rejected release URL — that is exactly
        # "the URL that would be used if not pinned".
        if is_rev_input "$input"; then
            base_url="$(reg_base_url "$input")"
            if [ -z "$branch" ] || [ -z "$base_url" ]; then
                log "keeping the $input pin — cannot read its pinned or normal URL; fix the registry"
                kept=1
            elif [ "$base_url" = "$branch" ]; then
                log "keeping the $input pin — $base_url is still the release that failed"
                kept=1
            elif reg_drop "$input"; then
                log "dropping the $input pin — new release to try: $base_url"
                changed=1
            else
                log "could not update flake-pins.json — keeping the $input pin"
                kept=1
            fi
            continue
        fi
        # An entry we cannot read (missing, null, or unreadable pnames) is not
        # evidence that anything cleared — keep the pin and say so.
        #
        # Read into a variable rather than piping into tr: `reg_pnames | tr`
        # reports tr's status and masks reg_pnames' non-zero exit, and an array
        # with a null member emits a partial list while still failing, so a
        # truncated name list could be mistaken for a complete one.
        if ! pnames="$(reg_pnames "$input")"; then
            log "keeping the $input pin — flake-pins.json entry has no usable package names; fix the registry"
            kept=1
            continue
        fi
        pnames_flat="$(printf '%s' "$pnames" | tr '\n' ' ')"
        if [ -z "${pnames_flat// /}" ]; then
            log "keeping the $input pin — flake-pins.json entry has no usable package names; fix the registry"
            kept=1
            continue
        fi
        still=0
        probe_err=0
        for p in $pnames; do
            needs_build "$input" "$branch" "$attr" "$p"
            case $? in
                0) still=1 ;;
                2) probe_err=1 ;;
            esac
        done
        if [ "$probe_err" -eq 1 ]; then
            log "keeping the $input pin — the probe could not be evaluated (safe default)"
            kept=1
        elif [ "$still" -eq 0 ]; then
            # Update the registry FIRST and only announce the drop if it took.
            if reg_drop "$input"; then
                log "dropping the $input pin — ${pnames_flat% } no longer build from source at $branch"
                changed=1
            else
                log "could not update flake-pins.json — keeping the $input pin"
                kept=1
            fi
        else
            log "keeping the $input pin — still building from source at $branch: ${pnames_flat% }"
            kept=1
        fi
    done

    # Reconcile: flake.nix must always match the registry. Without this, an empty
    # registry sitting alongside real pin lines (a hand-edit, or a drop whose
    # apply failed) would be reported as the benign "nothing to do". A pin drop
    # in the loop above has already changed the registry, so this call also
    # performs the single rewrite for the whole run.
    reconcile_block
    case $? in
        2) changed=1 ;;
        1) die "flake.nix does not match the registry and could not be rewritten — run 'nr-pins apply' to reconcile" ;;
    esac
    if [ "$changed" -eq 1 ]; then
        return 2
    fi
    [ "$kept" -eq 1 ] && return 1
    return 0
}

cmd_diagnose() { # after a failed build: pin whichever moved nixpkgs input causes it
    local logfile="${1:-}"
    [ -n "$logfile" ] && [ -r "$logfile" ] || die "usage: nr-pins diagnose <readable logfile>"
    reg_init
    # Fail closed: moved() reads the snapshot, and an unreadable one makes every
    # input look unmoved — which would end in the false "not a nixpkgs input
    # regression" verdict. Require it, loudly.
    [ -r "$SNAPSHOT" ] || die "no readable snapshot at $SNAPSHOT — run 'nr-pins snapshot' first; diagnose cannot tell which inputs moved"
    # Readability is not enough. A truncated, empty-but-valid, or node-less
    # snapshot makes moved() see an empty 'before' for every input, so each one
    # looks unmoved and the run ends on the exonerating verdict.
    jq -e '.nodes | type == "object" and length > 0' "$SNAPSHOT" > /dev/null 2>&1 \
        || die "the snapshot $SNAPSHOT has no usable nodes — run 'nr-pins snapshot' again; diagnose cannot tell which inputs moved"
    # Match the snapshot guard's strictness: a lock with zero nodes is as
    # unusable as a missing one, and `length > 0` closes the shapeless-lock case
    # that would otherwise enumerate zero inputs and reach the exonerating line.
    jq -e '.nodes | type == "object" and length > 0' "$LOCK" > /dev/null 2>&1 \
        || die "cannot read flake.lock ($LOCK) or it has no nodes — diagnose cannot tell which inputs moved"
    local attr drvs d p pnames input branch rev hit pinned=0 perr=0 probe_err=0 io_err=0
    local rinput rpnames snaprev odir opnames reverted=0
    attr="$(resolve_attr)" || die "could not resolve the system attribute to probe"

    drvs="$(strip_ansi < "$logfile" 2>/dev/null \
        | grep -oE "builder for '/nix/store/[a-z0-9]{32}-[^']+\.drv'" \
        | grep -oE "/nix/store/[a-z0-9]{32}-[^']+\.drv" | sort -u)"
    if [ -z "$drvs" ]; then
        log "no failing derivation in $logfile — not a build failure (eval error?) — not pinning"
        return 1
    fi

    pnames=""
    for d in $drvs; do
        p="$(drv_pname "$d")"
        if [ -n "$p" ]; then pnames="$pnames $p"; else log "could not determine a package name for $d"; fi
    done
    pnames="$(printf '%s\n' $pnames | sort -u | tr '\n' ' ')"
    [ -n "${pnames// /}" ] || { log "no package names derived — not pinning"; return 1; }
    log "failing: $(printf '%s ' $drvs)"
    log "package: ${pnames% }"

    # Prebuilt overlays first: an uncommitted overlay bump is the most specific
    # attribution available, and undoing it is free — it restores a committed
    # file, where a registry pin has to expire later. `revert_overlay` refuses
    # unless the directory's whole diff is a version/hash bump, so a hand edit is
    # never discarded and the failure falls through to the input logic below.
    for odir in $(overlay_dirs); do
        opnames="$(overlay_pnames "$odir")"
        [ -n "$opnames" ] || continue
        for p in $pnames; do
            printf '%s\n' "$opnames" | grep -qxF "$p" || continue
            log "$odir: its package $p is the failing derivation"
            revert_overlay "$odir"
            case $? in
                0) reverted=1 ;;
                2) io_err=1 ;;
            esac
            break
        done
    done
    if [ "$reverted" -eq 1 ]; then
        log "reverted a prebuilt-overlay bump — retrying the build with the last committed pin"
        return 3
    fi

    # Rev-pinned third-party inputs first. A moved input whose own package IS the
    # failing derivation is the specific culprit, and reverting it is safe: the
    # previous release already built, so its output is in the store. This must
    # run BEFORE the nixpkgs scan: a from-source package like pi is always in the
    # build plan, so `needs_build` would blame a nixpkgs bump for every failure
    # of it. If one is reverted, retry before considering nixpkgs at all — the
    # next attempt sees it as unmoved and falls through to the nixpkgs scan,
    # which keeps the retry loop convergent.
    for rinput in $(rev_inputs); do
        if ! moved "$rinput"; then
            log "$rinput did not move in this update — skipping"
            continue
        fi
        rpnames="$(reg_base_pnames "$rinput")"
        [ -n "$rpnames" ] || rpnames="$rinput"
        hit=""
        for p in $pnames; do
            printf '%s\n' "$rpnames" | grep -qxF "$p" && hit="$hit $p"
        done
        if [ -z "${hit// /}" ]; then
            log "$rinput: its packages ($(printf '%s ' $rpnames)) are not the failing one — not the culprit"
            continue
        fi
        snaprev="$(jq -r --arg n "$rinput" '.nodes[$n].locked.rev // empty' "$SNAPSHOT" 2>/dev/null)"
        if [ -z "$snaprev" ]; then
            log "$rinput: no rev for it in the snapshot — cannot revert it"
            io_err=1
            continue
        fi
        log "$rinput: release build failed (${hit# }); reverting to the last-good rev ${snaprev:0:12}"
        if reg_put "$(jq -n --arg i "$rinput" --arg b "$(reg_base_url "$rinput")" \
            --arg u "$(rev_pin_url "$rinput" "$snaprev")" \
            --argjson p "$(printf '%s\n' $hit | jq -R . | jq -cs .)" \
            --arg s "$(date '+%Y-%m-%d')" \
            --arg r "the release build failed here (via ${hit# }); reverted to the last release that built" \
            '{input: $i, branch: $b, url: $u, pnames: $p, since: $s, reason: $r}') "; then
            pinned=1
        else
            log "$rinput: could not write the registry — the revert was NOT recorded"
            io_err=1
        fi
    done
    if [ "$pinned" -eq 1 ]; then
        apply_block || die "reverted an input but flake.nix was not rewritten — run 'nr-pins apply' to reconcile"
        return 2
    fi

    # Enumerate first, and treat an EMPTY list as an anomaly rather than a clean
    # result: a lock that is parseable but shapeless (dangling root.inputs, nodes
    # with no owner/repo) yields nothing here, the loop below never runs, and the
    # run would otherwise end on the exonerating verdict.
    local inputs_list
    inputs_list="$(nixpkgs_inputs)"
    if [ -z "${inputs_list// /}" ]; then
        log "flake.lock declares no usable nixpkgs-family input — cannot tell which input regressed"
        io_err=1
    fi
    for input in $inputs_list; do
        # Order matters: resolve the branch AND the snapshot rev BEFORE
        # concluding that an input did not move. An absent snapshot rev means we
        # cannot tell whether it moved — that is an error, not exoneration.
        branch="$(branch_url "$input")"
        if [ -z "$branch" ]; then
            log "$input: no branch ref in flake.lock — cannot probe it"
            io_err=1
            continue
        fi
        rev="$(jq -r --arg n "$input" '.nodes[$n].locked.rev // empty' "$SNAPSHOT" 2>/dev/null)"
        if [ -z "$rev" ]; then
            log "$input: no rev for it in the snapshot — cannot tell whether it moved"
            io_err=1
            continue
        fi
        if ! moved "$input"; then
            log "$input did not move in this update — skipping"
            continue
        fi
        hit=""
        perr=0
        for p in $pnames; do
            needs_build "$input" "$branch" "$attr" "$p"
            case $? in
                0) hit="$hit $p" ;;
                2) perr=1 ;;
            esac
        done
        if [ "$perr" -eq 1 ]; then
            # Same rule as in check: a probe that errored is NOT "not the
            # culprit". Say so, and do not claim this input was exonerated.
            log "$input: the probe could not be evaluated — cannot tell whether it is the culprit"
            probe_err=1
            continue
        fi
        if [ -z "${hit// /}" ]; then
            log "$input: its branch head does not need ${pnames% } built — not the culprit"
            continue
        fi
        log "$input: branch head would still build ${hit# } from source — pinning to ${rev:0:12}"
        if reg_put "$(jq -n --arg i "$input" --arg b "$branch" --arg u "$(pin_url "$input" "$rev")" \
            --argjson p "$(printf '%s\n' $hit | jq -R . | jq -cs .)" \
            --arg s "$(date '+%Y-%m-%d')" \
            --arg r "must be built from source at $branch and the build fails here (via ${hit# })" \
            '{input: $i, branch: $b, url: $u, pnames: $p, since: $s, reason: $r}')"; then
            # A pin must be covered by .base, or this run would leave a registry
            # that every later command refuses (reg_init's coverage guard).
            reg_base_add "$input" "$branch" || {
                log "$input: pinned but could not add it to .base — the registry would be unusable"
                io_err=1
                continue
            }
            pinned=1
        else
            # A write failure must not fall through to the exonerating verdict.
            log "$input: could not write the registry — the pin was NOT recorded"
            io_err=1
        fi
    done

    if [ "$pinned" -eq 1 ]; then
        apply_block || die "pinned an input but flake.nix was not rewritten — run 'nr-pins apply' to reconcile"
        return 2
    fi
    if [ "$io_err" -eq 1 ]; then
        log "nothing pinned — this run could not read or write something it needed, so it could not tell"
        return 1
    fi
    if [ "$probe_err" -eq 1 ]; then
        log "nothing pinned — a probe could not be evaluated, so a regression may have been missed; re-run when the flake evaluates"
        return 1
    fi
    log "nothing pinnable — this failure is neither a nixpkgs input regression nor an uncommitted prebuilt-overlay bump"
    return 1
}

cmd_verify() { # verify <system-path> — smoke-test the packages the build produced
    # Runs after a SUCCESSFUL build, before `nr` switches to it. A prebuilt
    # package can build and still be broken: wrong payload, broken ad-hoc
    # signature, a config schema the new binary rejects. Each overlay may ship a
    # verify.sh (discovered exactly like update.sh); it is called as
    #
    #     verify.sh <system-path> <pname> <package-out-path>
    #
    # once per package name the overlay's default.nix declares, with the out
    # path resolved from the new system's closure. A failure is undone exactly
    # like a build failure: revert_overlay restores the last committed pin.
    local sys="${1:-}" dir pnames p matches n failed=0 reverted=0 verified=0
    [ -n "$sys" ] || die "usage: nr-pins verify <system-path>"
    [ -n "${NR_PINS_CLOSURE_FILE:-}" ] || [ -d "$sys" ] || die "no such system path: $sys"
    reg_init
    # Script-global, not local: the EXIT trap fires after this function has
    # returned, where a local would already be out of scope (and `set -u` turns
    # that into "closure: unbound variable" at exit).
    VERIFY_CLOSURE="$(mktemp)" || die "cannot create a temp file"
    closure="$VERIFY_CLOSURE"
    trap 'rm -f "$VERIFY_CLOSURE"' EXIT
    if [ -n "${NR_PINS_CLOSURE_FILE:-}" ]; then
        # Test seam: the fixture supplies the closure listing instead of nix.
        cp "$NR_PINS_CLOSURE_FILE" "$closure" || die "cannot read $NR_PINS_CLOSURE_FILE"
    elif ! nix-store -qR "$sys" > "$closure" 2> /dev/null; then
        log "cannot list the closure of $sys — nothing verified"
        return 1
    fi
    for dir in $(overlay_dirs); do
        [ -f "$FLAKE_DIR/$dir/verify.sh" ] || continue
        if [ ! -x "$FLAKE_DIR/$dir/verify.sh" ]; then
            # Fail closed: a hook that exists but cannot run would otherwise
            # read as "verified", which is the one thing it must never do.
            log "$dir/verify.sh is not executable — refusing to report it as verified"
            failed=1
            continue
        fi
        pnames="$(overlay_pnames "$dir")"
        [ -n "$pnames" ] || {
            log "$dir has a verify.sh but no pname — cannot resolve its package"
            failed=1
            continue
        }
        for p in $pnames; do
            # Exactly one store path in the closure may be this package at this
            # version: `<hash>-<pname>-<version>`. Anything else (none, or two
            # versions of it) means we cannot tell which artifact to test, and
            # testing the wrong one is worse than not testing.
            matches="$(sed -nE "s#^(/nix/store/[a-z0-9]{32}-$(rescape "$p")-[0-9][^/]*)\$#\1#p" "$closure")"
            n="$(printf '%s' "$matches" | grep -c . || true)"
            if [ "$n" -eq 0 ]; then
                log "$dir: $p is not in the closure of $sys — nothing to verify"
                continue
            fi
            if [ "$n" -gt 1 ]; then
                log "$dir: $p matches $n store paths in the closure — ambiguous, not verifying"
                continue
            fi
            verified=$((verified + 1))
            if bash "$FLAKE_DIR/$dir/verify.sh" "$sys" "$p" "$matches"; then
                log "$dir: $p passed its smoke test"
                continue
            fi
            log "$dir: $p FAILED its smoke test"
            failed=1
            revert_overlay "$dir"
            case $? in
                0) reverted=1 ;;
                1) log "$dir: nothing to revert — the failing pin is already committed" ;;
            esac
            break # one failure per directory is enough
        done
    done
    if [ "$reverted" -eq 1 ]; then
        return 3
    fi
    if [ "$failed" -eq 1 ]; then
        return 1
    fi
    log "verified $verified package(s)"
    return 0
}

cmd_list() {
    reg_init
    local n
    printf 'base inputs (always declared in flake.nix):\n'
    reg_base | while IFS=$'\t' read -r i u; do printf '  %s  %s\n' "$i" "$u"; done
    n="$(jq '.pins | length' "$REGISTRY")"
    if [ "$n" -eq 0 ]; then log "no pins"; return 0; fi
    jq -r '.pins[] | "  \(.input)  [\(.pnames | join(", "))]  since \(.since)\n    pinned:   \(.url)\n    normally: \(.branch)\n    why:      \(.reason)"' "$REGISTRY"
    return 1
}

cmd_apply() { reg_init; apply_block && log "rendered the pin block from the registry"; }

usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

case "${1:-}" in
    snapshot) cmd_snapshot ;;
    check) shift; cmd_check "$@" ;;
    diagnose) shift; cmd_diagnose "$@" ;;
    verify) shift; cmd_verify "$@" ;;
    list) cmd_list ;;
    apply) cmd_apply ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown subcommand: $1 (try --help)" ;;
esac
