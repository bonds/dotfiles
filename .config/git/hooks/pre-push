#!/usr/bin/env bash
# Pre-push hook — tracked at .config/git/hooks/pre-push (not .git/hooks/).
# Activated by core.hooksPath = ~/.config/git/hooks in the bare repo's config.
# Runs nix flake check --no-build --all-systems (evaluates checks for every declared
# system: format, deadnix, gitleaks, machine evals — not just the host's) plus explicit
# direct evals of each machine config, before pushing. --all-systems avoids the
# "omitted these incompatible systems" warning and covers both darwin and linux.
# Bypass with: git push --no-verify
set -euo pipefail

# The dotfiles checkout moved on 2026-10-31: on accismus the git dir is
# ~/.local/share/dotfiles/bare and the checkout is .../worktree, so
# $HOME/.config/nix is no longer the copy under review (it is only refreshed if
# something links it there). Validate the checkout when it exists; fall back to
# the flat layout for sophrosyne and metanoia.
flake_dir="$HOME/.local/share/dotfiles/worktree/.config/nix"
[ -d "$flake_dir" ] || flake_dir="$HOME/.config/nix"
cd "$flake_dir"
remote="$1"
url="$2"

echo "pre-push: nix flake check --no-build --all-systems (evaluates format/deadnix/gitleaks/machine evals)..."
if ! nix flake check --no-build --all-systems 2>&1; then
  echo "pre-push: nix flake check FAILED — push aborted." >&2
  echo "  Fix errors above or bypass with 'git push --no-verify'." >&2
  exit 1
fi

# Direct evals catch real config regressions (e.g. path typos like zen-icon) that
# the sandboxed `nix eval` inside the check derivations misses on macOS (the inner
# nix can't reach the daemon store as nixbld). Runs as the pushing user.
echo "pre-push: directly evaluating machine configs..."
for target in \
  nixosConfigurations.sophrosyne \
  nixosConfigurations.metanoia \
  darwinConfigurations.accismus; do
  echo "  evaluating .#$target..."
  if ! nix eval --raw ".#$target.config.system.build.toplevel.drvPath" >/dev/null 2>&1; then
    echo "pre-push: direct eval of .#$target FAILED — push aborted." >&2
    nix eval --raw ".#$target.config.system.build.toplevel.drvPath" >&2 2>&1 || true
    exit 1
  fi
done
echo "pre-push: all checks + direct evals passed."