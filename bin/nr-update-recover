#!/usr/bin/env bash
# nr-update-recover — undo an interrupted `nr --update`'s own half-written files.
#
# `nr --update` writes into $HOME (the apply checkout): the update scripts rewrite
# flake-pins.json, `nix flake update` rewrites flake.lock, and nr-pins renders
# flake.nix. Interrupt it after that and the next run starts from a tree a clean
# run would never start from — main *plus* half-written update output. `nr`'s
# guard then cannot tell pipeline output from hand work, so it refuses to apply
# main and quietly builds the stale tree.
#
# This script does one narrow thing: restore those three files to main, because
# the update re-derives them a moment later. It deliberately does NOT judge
# anything else — `nr-guard` already does that correctly (an older committed
# state is staleness, content that appears nowhere in history is work), and it
# runs again after this, so with the leftovers gone it can apply main.
#
# `nr-pins` is not in the list on purpose: it is a script people edit, and
# 5824dcd is the scar from treating a mid-edit copy as update output.
#
# Exit 0 always, unless git itself cannot restore the files (1).
#
#   NR_RECOVER_ROOT / NR_RECOVER_DOTFILES override the layout for the tests.
set -uo pipefail

ROOT="${NR_RECOVER_ROOT:-$HOME}"
DOTFILES="${NR_RECOVER_DOTFILES:-$ROOT/.local/share/dotfiles}"
GITDIR="$DOTFILES/bare"

g() { git --git-dir="$GITDIR" --work-tree="$ROOT" "$@"; }

[ -d "$GITDIR" ] || exit 0                 # not the bare-repo layout
g rev-parse --verify -q main >/dev/null || exit 0

# Regenerated by the update, so a leftover copy carries no information.
OWNED=(
	.config/nix/flake.lock
	.config/nix/flake-pins.json
	.config/nix/flake.nix
)

restored=""
for path in "${OWNED[@]}"; do
	[ -e "$ROOT/$path" ] || continue
	# Compare with main, not with the index: after an interrupted run the index
	# is as stale as the file, and main is the state a clean run starts from.
	g diff --quiet main -- "$path" 2>/dev/null && continue
	g checkout main -- "$path" >/dev/null 2>&1 || {
		printf 'nr: could not restore %s from main\n' "$path" >&2
		exit 1
	}
	restored="$restored$path "
done

[ -n "$restored" ] || exit 0
printf 'nr: recovering an interrupted update: restored %s from main\n' "${restored% }"
exit 0
