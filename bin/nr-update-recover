#!/usr/bin/env bash
# nr-update-recover — the files `nr --update` owns, and how a re-run resets them.
#
# Two jobs, one list, because they must not drift apart:
#
#   (default)   restore every update-managed file that differs from `main`, so a
#               re-run of an interrupted --update starts where a clean run would.
#   --paths     print them (absolute, existing only) for `nr`'s `git add`, so the
#               thing that gets committed is exactly the thing that gets reset.
#
# Why this exists: `nr --update` writes into $HOME (the apply checkout), so an
# interruption leaves half-written update output there. `nr`'s guard cannot tell
# pipeline output from hand work, so it refused to apply main and the re-run
# quietly built the stale tree. Versions of update-managed packages are not
# hand-edited here — the pipeline is the only writer — so its output carries no
# information worth keeping: discard it and let the update re-derive it.
#
# The list is DERIVED, not written out: every directory holding an `update.sh`
# contributes the pin files beside it. A hardcoded list is what let
# pkgs/swival/sources.nix go uncommitted for as long as it did — a new overlay or
# package is covered now the day it lands, not the day someone remembers.
#
# Deliberately NOT in the list:
#   - `nr-pins` / `nr-pins-tests.sh`: scripts, edited by hand. `nr` still commits
#     them, but restoring one would throw an edit away (5824dcd is the scar from
#     treating a mid-edit copy as update output).
#   - `pkgs/pi`: its update.sh moves a rev in the pin registry (already covered);
#     its package definition is hand-written, not generated.
#   - anything outside .config/nix: an update never writes it, so an edit there is
#     work, and the guard judges it as before.
#
# Exit 0 = coherent (nothing to do, or restored), 1 = git could not restore.
#
#   NR_RECOVER_ROOT / NR_RECOVER_DOTFILES override the layout for the tests.
set -uo pipefail

ROOT="${NR_RECOVER_ROOT:-$HOME}"
DOTFILES="${NR_RECOVER_DOTFILES:-$ROOT/.local/share/dotfiles}"
GITDIR="$DOTFILES/bare"

g() { git --git-dir="$GITDIR" --work-tree="$ROOT" "$@"; }

# Repo-relative paths an --update regenerates, one per line.
update_paths() {
	# Written by `nix flake update`, by nr-pins' render, and by the update
	# scripts that move a rev-pinned input (pi writes the registry).
	printf '%s\n' \
		.config/nix/flake.lock \
		.config/nix/flake-pins.json \
		.config/nix/flake.nix

	local script dir name
	for script in "$ROOT"/.config/nix/modules/overlays/*/update.sh \
		"$ROOT"/.config/nix/pkgs/*/update.sh; do
		[ -f "$script" ] || continue
		dir=${script%/update.sh}
		case "$dir" in
		"$ROOT"/.config/nix/pkgs/pi) continue ;;
		esac
		for name in default.nix sources.nix sources.json; do
			[ -e "$dir/$name" ] || continue
			# Only the file this script actually rewrites. Recovery DISCARDS, so
			# naming a package definition its updater never touches would throw
			# away an uncommitted edit to it — zen-browser and swival each keep a
			# default.nix beside their updater that it never writes.
			grep -q -- "$name" "$script" && printf '%s\n' "${dir#"$ROOT"/}/$name"
		done
	done
}

[ -d "$GITDIR" ] || exit 0                 # not the bare-repo layout
g rev-parse --verify -q main >/dev/null || exit 0

if [ "${1:-}" = "--paths" ]; then
	update_paths | while IFS= read -r path; do
		[ -e "$ROOT/$path" ] && printf '%s\n' "$ROOT/$path"
	done
	exit 0
fi

restored=""
while IFS= read -r path; do
	[ -e "$ROOT/$path" ] || continue
	# Compare with main, not with the index: after an interrupted run the index
	# is as stale as the file, and main is the state a clean run starts from.
	g diff --quiet main -- "$path" 2>/dev/null && continue
	g checkout main -- "$path" >/dev/null 2>&1 || {
		printf 'nr: could not restore %s from main\n' "$path" >&2
		exit 1
	}
	restored="$restored $path"
done < <(update_paths)

[ -n "$restored" ] || exit 0
printf 'nr: recovering an interrupted update: restored%s from main\n' "$restored"
exit 0
