#!/usr/bin/env bash
set -euo pipefail

# Nightly photo backup to sophrosyne — single-binary pipeline.
#
# photo-export (PhotoKit-native Swift CLI) exports ALL assets directly to the
# SMB mount, handling both iCloud-only and local originals. No osxphotos, no
# AppleScript, no XMP-rich sidecar (photo-export writes a minimal description +
# date sidecar). Manifest + atomic .part/rename writes make it resumable.

MNT="/tmp/sophrosyne-photos"
LOCKDIR="/tmp/photos-backup.lock"
LOGFILE="$HOME/Library/Logs/photos-backup.out.log"
ERRFILE="$HOME/Library/Logs/photos-backup.err.log"
# The app is installed by home-manager into "Applications/Home Manager Apps/"
# (that's what LaunchServices/`open` resolve). Fall back to a plain
# ~/Applications copy if it exists.
if [ -d "$HOME/Applications/Home Manager Apps/photo-export.app" ]; then
  APP="$HOME/Applications/Home Manager Apps/photo-export.app"
elif [ -d "$HOME/Applications/photo-export.app" ]; then
  APP="$HOME/Applications/photo-export.app"
else
  APP=""
fi

# Robust lock: store our PID inside the lock dir. If the lock exists but the
# PID inside it is no longer a live photo-backup process, the previous run was
# killed (SIGKILL/power loss bypasses `trap ... EXIT`) — reclaim the stale
# lock instead of skipping forever.
acquire_lock() {
  if mkdir "$LOCKDIR" 2>/dev/null; then
    echo $$ > "$LOCKDIR/pid"
    return 0
  fi
  local oldpid
  oldpid=$(cat "$LOCKDIR/pid" 2>/dev/null || echo "")
  if [ -n "$oldpid" ] && kill -0 "$oldpid" 2>/dev/null; then
    return 1   # genuinely still running
  fi
  # stale lock — remove and retry once
  echo "$(date) — stale lock (pid $oldpid) from a killed run; reclaiming" >> "$LOGFILE"
  rm -rf "$LOCKDIR"
  mkdir "$LOCKDIR" 2>/dev/null || return 1
  echo $$ > "$LOCKDIR/pid"
  return 0
}

if ! acquire_lock; then
  echo "$(date) — backup already running, skipping" >> "$LOGFILE"
  exit 0
fi
trap 'rm -rf "$LOCKDIR"' EXIT

PASS=$(security find-internet-password -s sophrosyne.local -a "photo-backup" -w 2>/dev/null)
if [ -z "$PASS" ]; then
  echo "$(date) — no Keychain entry for sophrosyne.local/photo-backup" >> "$LOGFILE"
  exit 0
fi

if [ ! -x "$APP/Contents/MacOS/photo-export" ]; then
  echo "$(date) — photo-export.app missing at $APP; nothing to run" >> "$LOGFILE"
  exit 0
fi

mkdir -p "$MNT"

EXPECT_SCRIPT=$(mktemp /tmp/photos-backup-expect.XXXXXX)
trap 'rm -rf "$LOCKDIR"; rm -f "$EXPECT_SCRIPT"' EXIT

cat > "$EXPECT_SCRIPT" << 'EXPECTEOF'
set pass [lindex $argv 0]
set mnt [lindex $argv 1]
spawn /sbin/mount_smbfs //photo-backup@sophrosyne.local/photos $mnt
expect "assword:"
send "$pass\r"
expect eof
catch wait result
exit [lindex $result 3]
EXPECTEOF

if ! expect "$EXPECT_SCRIPT" "$PASS" "$MNT" >> "$LOGFILE" 2>> "$ERRFILE"; then
  echo "$(date) — mount failed" >> "$LOGFILE"
  rmdir "$MNT" 2>/dev/null || true
  exit 0
fi

if ! mount | grep -qF "$MNT"; then
  echo "$(date) — mount verification failed, $MNT not mounted" >> "$LOGFILE"
  rmdir "$MNT" 2>/dev/null || true
  exit 0
fi

echo "$(date) — mount OK, exporting via photo-export..." >> "$LOGFILE"

# MUST launch via `open` so macOS registers the app identity with TCC (direct
# exec of the binary gets PHAuthorizationStatusDenied). Use the EXPLICIT app
# path — `open -a photo-export` can resolve to the Home Manager Apps copy
# (stale) instead of the nix-store symlink. -W blocks until photo-export
# exits, so we don't unmount mid-export; the manifest makes reruns resumable.
open -j -W "$APP" 2>>"$ERRFILE" >>"$LOGFILE"

umount "$MNT" 2>/dev/null || true
echo "$(date) — backup complete" >> "$LOGFILE"