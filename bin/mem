#!/usr/bin/env python3
"""mem — one memory store for every agent harness (pi, opencode, hermes, osaurus).

The store is files, so it is already harness-neutral; this CLI is the neutral
*interface* to it, so a lesson captured by one harness is readable, promotable
and recallable from any other:

  ~/.local/share/agents/memory/inbox.md   one inbox; every harness appends (flock'd)
  <repo>/docs/learnings/        one entry per domain lesson, indexed
  ~/DECISIONS.md                settled choices and their rationale
  agent-skills/memory/SKILL.md  the policy: when to capture, how to distill

Subcommands:
  mem learn <slug> --title T --symptom S --cause C --fix F [--repo DIR]
  mem inbox add <kind> <text> [--session S]
  mem inbox show
  mem distill
  mem recall <query> [--days N] [--limit N] [--source pi|opencode|hermes]
  mem decisions
  mem help

Exit codes: 0 ok · 1 nothing to do / refused · 2 usage error.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import pathlib
import re
import sqlite3
import subprocess
import sys

HOME = pathlib.Path.home()


def _xdg_data_home() -> pathlib.Path:
    """`$XDG_DATA_HOME`, or the XDG default `~/.local/share` when unset."""
    configured = os.environ.get("XDG_DATA_HOME")
    return pathlib.Path(configured) if configured else HOME / ".local" / "share"


# The store is agent-neutral data, not config and not cache, so it lives under
# XDG_DATA_HOME. MEMORY_DIR/MEM_DIR still win, which is what the tests use.
MEMORY_DIR = pathlib.Path(
    os.environ.get("MEMORY_DIR")
    or os.environ.get("MEM_DIR")
    or _xdg_data_home() / "agents" / "memory"
)
INBOX = MEMORY_DIR / "inbox.md"
DECISIONS = HOME / "DECISIONS.md"
# Recall sources, overridable so the test suite can point at fixtures.
PI_SESSIONS = pathlib.Path(os.environ.get("MEM_PI_SESSIONS", HOME / ".pi" / "agent" / "sessions"))
OPENCODE_DB = pathlib.Path(os.environ.get("MEM_OPENCODE_DB", HOME / ".local" / "share" / "opencode" / "opencode.db"))
HERMES_DB = pathlib.Path(os.environ.get("MEM_HERMES_DB", HOME / ".hermes" / "state.db"))
OSAURUS_DB = pathlib.Path(os.environ.get("MEM_OSAURUS_DB", HOME / ".osaurus" / "activity" / "activity.sqlite"))

INBOX_HEADER = """# Learnings inbox

Candidates appended by every agent harness — pi (`learnings-capture` and
`corrections-capture`), opencode and hermes hooks, or `mem inbox add` — when a
tool call failed, or when the user corrected the agent or stated a rule.

Run `mem distill` (or `/distill` in any harness) to cluster these and promote
each one up the ladder: AGENTS.md line -> skill -> hook/extension -> automation.
Then empty this file. Do not edit by hand: delete lines instead.
"""

LADDER = """\
Promotion ladder — a candidate is only resolved when it moves UP a rung:

  1. AGENTS.md line      a rule worth always having in context
  2. skill               a rule needed on demand, or detail AGENTS.md must not hold
  3. hook / extension    a rule that should not depend on the agent remembering
  4. automation          a script, so it cannot be forgotten at all

Seen twice -> rung 3. AGENTS.md must not grow: moving a paragraph into a skill
is part of the same edit. A correction that is really a fact about a project
belongs in that repo's docs/learnings/ instead (mem learn), not here."""


def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[name-defined]
    print(f"mem: {msg}", file=sys.stderr)
    raise SystemExit(code)


def today() -> str:
    return dt.date.today().isoformat()


def now_stamp() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d %H:%M")


# --------------------------------------------------------------------- inbox --


def append_locked(line: str) -> bool:
    """Append one line to the inbox under an exclusive lock.

    flock, not a read-then-write race: several harnesses write this file, and a
    half-written line would corrupt the one thing every agent reads. Returns
    False when the same text is already present (the inbox is a set of
    unresolved lessons, not a log).
    """
    MEMORY_DIR.mkdir(parents=True, exist_ok=True)
    body = line.rstrip("\n")
    with open(INBOX, "a+", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            fh.seek(0)
            existing = fh.read()
            # Whole-line identity, not a substring test: "parallel line 1" is a
            # substring of "parallel line 11", and a substring dedupe silently
            # swallowed the shorter lesson.
            if any(ln.rstrip() == body for ln in existing.splitlines()):
                return False
            # The header is written INSIDE the lock: two harnesses capturing
            # their first lesson at the same moment must not both create the
            # file, the second truncating the first one's line.
            if not existing.strip():
                fh.write(INBOX_HEADER + "\n")
            fh.write(body + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    return True


def cmd_inbox_add(args) -> int:
    text = " ".join(args.text).strip()
    if not text:
        die("inbox add needs some text", 2)
    line = f"- [{now_stamp()}] {args.kind} — {text}"
    if args.session:
        line += f" — ~ — session {args.session}"
    if append_locked(line):
        print(f"mem: captured ({args.kind})")
        return 0
    print("mem: already in the inbox", file=sys.stderr)
    return 1


def inbox_candidates() -> list[str]:
    if not INBOX.exists():
        return []
    return [ln for ln in INBOX.read_text(encoding="utf-8").splitlines() if ln.startswith("- [")]


def cmd_inbox_show(_args) -> int:
    if not INBOX.exists():
        print(f"mem: no inbox yet at {INBOX}")
        return 0
    sys.stdout.write(INBOX.read_text(encoding="utf-8"))
    return 0


def cmd_distill(_args) -> int:
    cands = inbox_candidates()
    if not cands:
        print(f"mem: inbox is empty ({INBOX}) — nothing to distill")
        return 0
    print(f"{len(cands)} candidate(s) in {INBOX}\n")
    for c in cands:
        print(c)
    print("\n" + LADDER)
    print("\nWhen done: delete the lines you promoted (do not edit them).")
    return 0


# -------------------------------------------------------------------- learn --


def slugify(text: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return re.sub(r"-{2,}", "-", s)[:60] or "lesson"


def git_toplevel(start: pathlib.Path | None = None) -> pathlib.Path | None:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(start or pathlib.Path.cwd()),
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    return pathlib.Path(out) if out else None


def cmd_learn(args) -> int:
    repo = pathlib.Path(args.repo).expanduser() if args.repo else git_toplevel()
    if repo is None:
        die(
            "not inside a git repository, so there is nowhere for this to live — "
            "pass --repo DIR for a repo elsewhere, or use `mem inbox add` for an "
            "agent-behaviour lesson"
        )
    learnings = repo / "docs" / "learnings"
    if not learnings.is_dir():
        die(f"{learnings} does not exist — create it (with a README.md index) or pass --repo")
    slug = slugify(args.slug or args.title)
    path = learnings / f"{today()}-{slug}.md"
    if path.exists() and not args.force:
        die(f"{path.relative_to(repo)} already exists (use --force to overwrite)")
    body = f"""# {args.title}

**Date:** {today()}

## Symptom

{args.symptom}

## Cause

{args.cause}

## Fix

{args.fix}
"""
    if args.see:
        body += "\n## See also\n\n" + "\n".join(f"- {s}" for s in args.see) + "\n"
    path.write_text(body, encoding="utf-8")
    index = learnings / "README.md"
    entry = f"- [{today()} — {args.title}]({path.name})"
    if index.exists():
        text = index.read_text(encoding="utf-8")
        if path.name not in text:
            if not text.endswith("\n"):
                text += "\n"
            if "## Entries" not in text:
                text += "\n## Entries\n\n"
            index.write_text(text + entry + "\n", encoding="utf-8")
    else:
        index.write_text(
            f"# Learnings\n\nDomain lessons: symptom / cause / fix, one per file.\n\n## Entries\n\n{entry}\n",
            encoding="utf-8",
        )
    print(f"mem: wrote {path.relative_to(repo)}")
    print(f"mem: indexed in {(index.relative_to(repo))}")
    return 0


def cmd_decisions(_args) -> int:
    if not DECISIONS.exists():
        die(f"no {DECISIONS}")
    sys.stdout.write(DECISIONS.read_text(encoding="utf-8"))
    return 0


# ------------------------------------------------------------------- recall --


def _words(q: str) -> list[str]:
    return [w.lower() for w in re.findall(r"[A-Za-z0-9_./:@+-]+", q)]


def _matches(text: str, words: list[str]) -> bool:
    low = text.lower()
    return all(w in low for w in words)


def _snippet(text: str, words: list[str], width: int = 150) -> str:
    flat = " ".join(text.split())
    low = flat.lower()
    pos = min((low.find(w) for w in words if w in low), default=0)
    start = max(0, pos - width // 3)
    out = flat[start : start + width]
    return ("…" if start else "") + out + ("…" if start + width < len(flat) else "")


def recall_pi(words: list[str], since: float, limit: int) -> list[dict]:
    hits: list[dict] = []
    if not PI_SESSIONS.is_dir():
        return hits
    for path in sorted(PI_SESSIONS.rglob("*.jsonl"), key=lambda p: -p.stat().st_mtime):
        if path.stat().st_mtime < since:
            continue
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        for raw in lines:
            try:
                obj = json.loads(raw)
            except ValueError:
                continue
            if obj.get("type") != "message":
                continue
            msg = obj.get("message") or {}
            content = msg.get("content")
            if isinstance(content, str):
                text = content
            elif isinstance(content, list):
                text = " ".join(
                    b.get("text", "") for b in content if isinstance(b, dict) and isinstance(b.get("text"), str)
                )
            else:
                continue
            if not text or not _matches(text, words):
                continue
            hits.append(
                {
                    "source": "pi",
                    "when": obj.get("timestamp", ""),
                    "session": obj.get("id") or path.stem,
                    "role": msg.get("role", ""),
                    "text": _snippet(text, words),
                }
            )
            break  # one hit per session is enough
        if len(hits) >= limit:
            break
    return hits


def recall_opencode(words: list[str], since: float, limit: int) -> list[dict]:
    if not OPENCODE_DB.exists():
        return []
    hits: list[dict] = []
    ms = int(since * 1000)
    try:
        con = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True, timeout=5)
    except sqlite3.Error:
        return []
    try:
        cur = con.execute(
            """
            SELECT s.id, s.title, p.time_created, p.data
            FROM part p JOIN session s ON s.id = p.session_id
            WHERE p.time_created >= ? AND p.data LIKE ?
            ORDER BY p.time_created DESC LIMIT ?
            """,
            (ms, f"%{words[0]}%", limit * 20),
        )
        for sid, title, ts, data in cur:
            text = data
            try:
                parsed = json.loads(data)
                text = parsed.get("text") or parsed.get("content") or data
                if isinstance(text, list):
                    text = " ".join(str(x) for x in text)
            except ValueError:
                pass
            if not _matches(str(text), words):
                continue
            hits.append(
                {
                    "source": "opencode",
                    "when": dt.datetime.fromtimestamp(ts / 1000).strftime("%Y-%m-%d %H:%M"),
                    "session": title or sid,
                    "role": "",
                    "text": _snippet(str(text), words),
                }
            )
            if len(hits) >= limit:
                break
    except sqlite3.Error:
        return hits
    finally:
        con.close()
    return hits


def recall_hermes(words: list[str], since: float, limit: int) -> list[dict]:
    if not HERMES_DB.exists():
        return []
    hits: list[dict] = []
    try:
        con = sqlite3.connect(f"file:{HERMES_DB}?mode=ro", uri=True, timeout=5)
    except sqlite3.Error:
        return []
    try:
        cur = con.execute(
            """
            SELECT m.session_id, COALESCE(s.title, ''), m.timestamp, m.role, m.content
            FROM messages m LEFT JOIN sessions s ON s.id = m.session_id
            WHERE m.timestamp >= ? AND m.content LIKE ?
            ORDER BY m.timestamp DESC LIMIT ?
            """,
            (since, f"%{words[0]}%", limit * 20),
        )
        for sid, title, ts, role, content in cur:
            if not content or not _matches(str(content), words):
                continue
            hits.append(
                {
                    "source": "hermes",
                    "when": dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M"),
                    "session": title or sid,
                    "role": role or "",
                    "text": _snippet(str(content), words),
                }
            )
            if len(hits) >= limit:
                break
    except sqlite3.Error:
        return hits
    finally:
        con.close()
    return hits


def cmd_recall(args) -> int:
    words = _words(args.query)
    if not words:
        die("recall needs a query", 2)

    hits: list[dict] = []
    stores = {"pi": recall_pi, "opencode": recall_opencode, "hermes": recall_hermes}

    if args.source in stores:
        since = (dt.datetime.now() - dt.timedelta(days=args.days)).timestamp()
        hits.extend(stores[args.source](words, since, args.limit))
    else:
        if args.source in ("archive", "all") and (RAW_DIR / "messages").is_dir():
            hits.extend(recall_archive(words, args.days, args.limit))
        if args.source in ("docs", "all"):
            hits.extend(recall_docs(words, args.days, args.limit, args.include_archive))
        # The stores stay the fallback, as the plan says: they are the only
        # source for a session newer than the last ingest, and asking them when
        # the archive already answered would return every hit twice.
        if args.source == "all" and not hits:
            since = (dt.datetime.now() - dt.timedelta(days=args.days)).timestamp()
            for fn in stores.values():
                hits.extend(fn(words, since, args.limit))

    if not hits:
        print(f"mem: nothing in the last {args.days}d matching {' '.join(words)}")
        return 0
    # One long session can otherwise answer every question with itself: the
    # conversation you are in mentions everything you are asking about, and 556
    # turns of it will fill any result limit. Cap how much one session may
    # contribute, and rank by how many query words a hit actually contains
    # before ranking by recency.
    grouped: dict = {}
    for hit in hits:
        grouped.setdefault((hit["source"], hit["session"]), []).append(hit)
    hits = []
    for group in grouped.values():
        group.sort(key=lambda h: (h.get("score", 0), h["when"]), reverse=True)
        hits.extend(group[:2])

    # Curated first, transcripts second. Sorting the two together by date would
    # bury every learnings entry under this week's conversation it came out of,
    # which inverts the point: the distilled answer is the answer, the session is
    # its evidence.
    curated = sorted((h for h in hits if h["source"].startswith("docs/")),
                     key=lambda h: (h.get("score", 0), h["when"]), reverse=True)
    evidence = sorted((h for h in hits if not h["source"].startswith("docs/")),
                      key=lambda h: (h.get("score", 0), h["when"]), reverse=True)

    ordered = curated + evidence
    if args.json:
        # Same order the display would use, so an eval tests the ranking a
        # reader actually sees. Records instead of text: the display truncates
        # ids and snippets, and assertions should not care.
        print(json.dumps(ordered, indent=2))
        return 0

    def show(group, cap):
        for h in group[:cap]:
            role = f" ({h['role']})" if h.get("role") else ""
            print(f"{h['when'][:16]:16}  {h['source']:16}  {str(h['session'])[:38]:38}{role}")
            print(f"    {h['text']}")

    if curated:
        print(f"mem: {len(curated)} curated, {len(evidence)} from transcripts")
        show(curated, args.limit)
        if evidence:
            print("  -- transcripts --")
    show(evidence, args.limit * 2)
    return 0


# ---------------------------------------------------------------- archive --
#
# Capture is ingestion, not interception. Every harness already records what a
# proxy would have captured: the system prompt, the tool schemas, token counts,
# cost. So the archive is built by reading those stores, normalising each
# message into a content-addressed record, and keeping a derived per-session
# turn log that points at them.
#
# The archive is the system of record because the stores are not durable: pi's
# session files rotate, opencode and hermes compact in place, osaurus prunes
# activity rows. Copying out, with our own integrity story, is the whole point —
# hence the hash chain over each session's turns.

RAW_DIR = pathlib.Path(os.environ.get("MEMORY_RAW") or MEMORY_DIR.parent / "raw")
GENESIS = "mem-archive-v1"

# Longest and most specific first, so the generic assignment pattern cannot
# swallow a variable name that a narrower pattern already claimed.
_SECRETS = [
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----"), "private_key"),
    (re.compile(r"\bsk-[A-Za-z0-9_\-]{20,}"), "api_key"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}"), "gh_token"),
    (re.compile(r"\bghp_[A-Za-z0-9]{20,}"), "gh_token"),
    (re.compile(r"\bxox[baprs]-[A-Za-z0-9\-]{10,}"), "slack_token"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "aws_key"),
    (re.compile(r"(?i)\b(bearer)\s+[A-Za-z0-9._\-]{16,}"), "bearer"),
]

# Assignments need a judgement call, not a pattern. `maxTokens = 1048576`,
# `const apiKey = config.value` and `NOPASSWD: ALL` are configuration and code,
# and redacting them corrupts the transcripts this archive exists to preserve.
# Real credentials in a transcript look like an ENV assignment: an upper-case
# name with an underscore, and a value with a digit or a symbol.
_ASSIGNMENT = re.compile(
    r"\b([A-Z][A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD)[A-Z0-9_]*)"
    r"\s*[:=]\s*([\"']?)([^\s\"',;}\]){(]{16,})"
)


def looks_secret(value: str) -> bool:
    """True when a value looks like a credential rather than a number or code."""
    if len(value) < 16 or not any(c.isalpha() for c in value):
        return False  # 1048576 is a context window, not a key
    return (
        any(c.isdigit() for c in value)
        or any(not c.isalnum() for c in value)
        or len(value) >= 24  # a long all-alphabetic value is still suspicious
    )


def canonical(obj) -> str:
    """Stable JSON: sorted keys, no whitespace, so a digest means one thing."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def redact_text(text: str) -> tuple[str, int]:
    """Replace secrets with a marker; returns the text and how many were hit."""
    count = 0
    for pattern, kind in _SECRETS:
        marker = f"[REDACTED:{kind}]"
        if pattern.groups:
            text, hits = pattern.subn(lambda m: f"{m.group(1)} {marker}", text)
        else:
            text, hits = pattern.subn(marker, text)
        count += hits

    def swap(match) -> str:
        nonlocal count
        name = match.group(1)
        # An env-style name has an underscore, or is the bare word. That alone
        # drops `NOPASSWD`, which contains PASSWD but is a sudoers permission.
        if "_" not in name and name not in ("KEY", "TOKEN", "SECRET", "PASSWORD"):
            return match.group(0)
        if "REDACTED" in match.group(3) or not looks_secret(match.group(3)):
            return match.group(0)  # already marked, or not credential-shaped
        count += 1
        return f"{name} {match.group(2)}[REDACTED:assignment]"

    text = _ASSIGNMENT.sub(swap, text)
    return text, count


def redact_obj(obj, tally: list) -> object:
    if isinstance(obj, str):
        text, hits = redact_text(obj)
        tally[0] += hits
        return text
    if isinstance(obj, list):
        return [redact_obj(v, tally) for v in obj]
    if isinstance(obj, dict):
        return {k: redact_obj(v, tally) for k, v in obj.items()}
    return obj


def write_atomic(path: pathlib.Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def store_message(doc: dict, dry_run: bool = False) -> tuple[str, bool]:
    """Write one message under its content digest. Returns (digest, created)."""
    body = canonical(doc)
    digest = hashlib.sha256(body.encode()).hexdigest()
    path = RAW_DIR / "messages" / digest[:2] / f"{digest}.json"
    if path.exists():
        return digest, False
    if not dry_run:
        write_atomic(path, body + "\n")
    return digest, True


# pi content parts are already close to ours; keep the mapping explicit rather
# than pass them through, so a harness reshaping its parts shows up as an
# unknown part instead of silently changing what we store.
def pi_parts(raw) -> list:
    if not isinstance(raw, list):
        raw = [{"type": "text", "text": "" if raw is None else raw}]
    parts = raw
    out = []
    for part in parts:
        if not isinstance(part, dict):
            out.append({"type": "text", "text": str(part)})
            continue
        kind = part.get("type")
        if kind == "text":
            out.append({"type": "text", "text": part.get("text", "")})
        elif kind == "thinking":
            out.append({"type": "reasoning", "text": part.get("thinking", "")})
        elif kind == "toolCall":
            out.append({
                "type": "tool_call",
                "id": part.get("id"),
                "name": part.get("name"),
                "arguments": part.get("arguments"),
            })
        else:
            out.append(part)  # unknown shape: keep it verbatim rather than lose it
    return out


def chain_turns(turns: list, session_id: str) -> list:
    """Chain turns so an edit to the archive is visible rather than only unverified."""
    prev_hash = hashlib.sha256(f"{GENESIS}:{session_id}".encode()).hexdigest()
    chained = []
    for turn in turns:
        digest = hashlib.sha256(canonical(turn).encode()).hexdigest()
        chained.append({**turn, "prev": prev_hash, "hash": digest})
        prev_hash = digest
    return chained


_PATH_KEYS = ("path", "file", "file_path", "filename", "target", "dir", "directory", "cwd")
_CMD_KEYS = ("cmd", "command", "script", "bash", "shell")

# Harnesses disagree on how a failed tool call is recorded: pi flags the result
# message, opencode puts `status: error` on the tool part, osaurus carries an
# HTTP status on the turn, and hermes records nothing at all. The phrase list is
# the same one the capture hooks use, so "what counts as a failure" stays
# consistent between the inbox and the graph.
_ERROR_PHRASE = re.compile(
    r"(?i)(no such file or directory|permission denied|command not found"
    r"|operation not permitted|traceback \(most recent call last\)|segmentation fault"
    r"|fatal:|exit code [1-9]|is not a function|unknown option|invalid option)")


def unwrap_output(text: str) -> str:
    """hermes stores a tool result as JSON: {"output": ..., "exit_code": ...}."""
    stripped = text.strip()
    if not stripped.startswith("{"):
        return text
    try:
        obj = json.loads(stripped)
    except json.JSONDecodeError:
        return text
    if isinstance(obj, dict):
        for key in ("output", "content", "message", "error"):
            value = obj.get(key)
            if isinstance(value, str) and value.strip():
                return value
    return text


def first_error_line(text: str) -> str:
    for line in str(text or "").splitlines():
        if _ERROR_PHRASE.search(line):
            return line.strip()[:160]
    return ""


def looks_like_path(value: str) -> bool:
    if not value or len(value) > 240 or "\n" in value:
        return False
    if value.startswith(("http://", "https://")):
        return False
    return value.startswith(("/", "~/", "./", "../")) or ("/" in value and " " not in value.strip())


def extract_edges(doc: dict, cwd: str | None) -> list:
    """Deterministic entities from a message: the things a provenance graph needs."""
    edges = []
    role = doc.get("role")

    for part in doc.get("content") or []:
        if part.get("type") != "tool_call":
            continue
        args = part.get("arguments")
        if args is None:
            args = part.get("input")
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except json.JSONDecodeError:
                args = {"raw": args}
        if not isinstance(args, dict):
            continue
        status = str(part.get("status") or "").lower()
        if status in ("error", "failed"):
            output = unwrap_output(str(part.get("output") or ""))
            # `rg`/`grep`/`glob` exit non-zero for "no matches", which is a
            # result, not a failure — the capture hooks learned this the same
            # way. Require a recognizable signature, or enough output to be a
            # real error rather than an empty result.
            signature = first_error_line(output)
            if not signature and len(output.strip()) >= 80:
                signature = output.strip().splitlines()[0][:160]
            if signature:
                edges.append(("error", signature))

        for key, value in args.items():
            if not isinstance(value, str) or not value.strip():
                continue
            low = key.lower()
            if low in _CMD_KEYS or (isinstance(value, str) and value.startswith("#!/")):
                edges.append(("command", value[:200]))
            elif low in _PATH_KEYS or looks_like_path(value):
                edges.append(("file", value[:200]))

    if role == "tool":
        text = unwrap_output(" ".join(str(p.get("text") or "") for p in doc.get("content") or ""))
        flagged = bool(doc.get("is_error")) or str(doc.get("status") or "").lower() in ("error", "failed")
        signature = first_error_line(text)
        if signature:
            edges.append(("error", signature))
        elif flagged and len(text.strip()) >= 80:
            edges.append(("error", text.strip().splitlines()[0][:160]))

    # Dedupe, and cap: a turn that touched 200 files is not more useful than one
    # that touched 20, but it is much more expensive to query.
    seen = set()
    unique = []
    for kind, value in edges:
        if kind == "file":
            value = str(pathlib.PurePath(value))
            if cwd and not value.startswith(("/", "~")) and (pathlib.Path(cwd) / value).exists():
                value = str(pathlib.Path(cwd) / value)
        key = (kind, value)
        if key in seen:
            continue
        seen.add(key)
        unique.append({"kind": kind, "dst": value})
        if len(unique) >= 25:
            break
    return unique


def write_session(harness: str, session_id: str, manifest: dict, turns: list, dry_run: bool) -> None:
    if dry_run:
        return
    stamp = str(manifest.get("started") or "")
    if len(stamp) >= 7 and stamp[4] == "-":
        year, month = stamp[:4], stamp[5:7]
    else:
        now = dt.datetime.now()
        year, month = now.strftime("%Y"), now.strftime("%m")
    out = RAW_DIR / "sessions" / harness / year / month / session_id
    write_atomic(out / "session.json", json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    write_atomic(out / "turns.jsonl", "".join(canonical(t) + "\n" for t in turns))

    # Edges are derived from the messages already on disk, so every importer
    # gets them without knowing they exist.
    cwd = manifest.get("cwd")
    edges = []
    for turn in turns:
        digest = turn.get("msg")
        path = message_path(digest) if digest else None
        if not path or not path.exists():
            continue
        try:
            doc = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        for edge in extract_edges(doc, cwd):
            edges.append({**edge, "turn": turn.get("i"), "ts": turn.get("ts")})
        # osaurus records an HTTP status per call rather than flagging content.
        status = turn.get("status")
        if isinstance(status, int) and status >= 400:
            edges.append({"kind": "error", "dst": f"http {status} {turn.get('path') or ''}".strip()[:160],
                          "turn": turn.get("i"), "ts": turn.get("ts")})
    if edges:
        write_atomic(out / "edges.jsonl", "".join(canonical(e) + "\n" for e in edges))


def ms_to_iso(value) -> str | None:
    if not value:
        return None
    return dt.datetime.fromtimestamp(int(value) / 1000, dt.timezone.utc).isoformat(timespec="milliseconds")


def cap_text(text, limit: int = 16 * 1024) -> str:
    """Keep head and tail of a large tool output (plan D5).

    Tool results are most of the bytes and least of the causal chain; a rendered
    build log or file dump pushes a session into the hundreds of KB without
    telling a later reader anything the head and tail do not.
    """
    if not isinstance(text, str) or len(text) <= limit:
        return text
    head = limit // 2
    tail = limit // 4
    digest = hashlib.sha256(text.encode()).hexdigest()[:12]
    return (
        text[:head]
        + f"\n…[truncated {len(text)} chars, sha256:{digest}]…\n"
        + text[-tail:]
    )


def ingest_pi_session(path: pathlib.Path, state: dict, dry_run: bool) -> dict:
    """Normalise one pi session file. Idempotent: every write is content-addressed."""
    result = {"id": None, "turns": 0, "created": 0, "skipped": False}
    st = path.stat()
    key = str(path)
    prev = state["sessions"].get(key) or {}
    if prev.get("size") == st.st_size and prev.get("mtime_ns") == st.st_mtime_ns:
        result["skipped"] = True
        return result

    lines = []
    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            lines.append(json.loads(line))
        except json.JSONDecodeError:
            continue  # a half-written trailing line; the next pass picks it up

    head = next((o for o in lines if o.get("type") == "session"), {})
    session_id = str(head.get("id") or path.stem)
    result["id"] = session_id

    turns: list = []
    changes: list = []
    models: list = []
    tally = [0]
    usage = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "reasoning": 0}
    cost = 0.0

    for obj in lines:
        kind = obj.get("type")
        if kind in ("model_change", "thinking_level_change"):
            changes.append({k: v for k, v in obj.items() if k != "type"} | {"type": kind})
            continue
        if kind != "message":
            continue

        msg = obj.get("message") or {}
        role = msg.get("role")
        if role == "toolResult":
            role = "tool"

        doc = {"v": 1, "role": role, "content": pi_parts(msg.get("content"))}
        if role == "tool":
            doc["tool_call_id"] = msg.get("toolCallId")
            doc["tool_name"] = msg.get("toolName")
            doc["is_error"] = msg.get("isError")
        doc = {k: v for k, v in doc.items() if v is not None}
        digest, created = store_message(redact_obj(doc, tally), dry_run)
        result["created"] += 1 if created else 0

        turn = {"i": len(turns), "ts": obj.get("timestamp"), "role": role, "msg": digest}
        if role == "assistant":
            turn.update({
                "model": msg.get("model"),
                "provider": msg.get("provider"),
                "thinking_level": msg.get("thinkingLevel"),
                "stop_reason": msg.get("stopReason"),
                "response_id": msg.get("responseId"),
                "duration_ms": msg.get("durationMs"),
            })
            turn = {k: v for k, v in turn.items() if v is not None}
            spend = msg.get("usage") or {}
            for src, dst in (("input", "input"), ("output", "output"), ("cacheRead", "cache_read"),
                             ("cacheWrite", "cache_write"), ("reasoning", "reasoning")):
                usage[dst] += int(spend.get(src) or 0)
            billed = spend.get("cost")
            if isinstance(billed, dict):
                cost += float(billed.get("total") or sum(
                    v for v in billed.values() if isinstance(v, (int, float))))
            elif isinstance(billed, (int, float)):
                cost += float(billed)
            model = msg.get("model")
            if model and model not in models:
                models.append(model)
        turns.append(turn)
        result["turns"] += 1

    # Chain the turns so a later edit to the archive is visible.
    chained = chain_turns(turns, session_id)

    started = head.get("timestamp") or (turns[0]["ts"] if turns else None)

    manifest = {
        "v": 1,
        "id": session_id,
        "harness": "pi",
        "started": started,
        "ended": turns[-1]["ts"] if turns else started,
        "cwd": head.get("cwd"),
        "models": models or ([head.get("modelId")] if head.get("modelId") else []),
        "thinking_level": head.get("thinkingLevel"),
        "turns": len(chained),
        "usage": usage,
        "cost_usd": round(cost, 6),
        "redactions": tally[0],
        "retention": "hot",
        "changes": changes,
        "source": {"path": key, "size": st.st_size, "mtime_ns": st.st_mtime_ns},
    }

    write_session("pi", session_id, manifest, chained, dry_run)
    return result


# ---------------------------------------------------------------- opencode --
#
# opencode's V2 store keeps one row per turn in `session_message` (type + seq +
# a JSON `data`), which is both simpler and richer than the V1 message/part
# pair: it carries the composed system prompt as text, and the compaction events
# with their summaries. Those compaction rows are why this reads V2 — they are
# the pre-compaction narrative that D17 says an archive must not lose.

_OPENCODE_ROLES = {
    "user": "user",
    "assistant": "assistant",
    "system": "system",
    "synthetic": "synthetic",
    "compaction": "compaction",
}

_EVENT_TYPES = ("idle", "model-switched", "agent-switched")


def opencode_parts(content) -> list:
    out = []
    for part in content or []:
        if not isinstance(part, dict):
            out.append({"type": "text", "text": str(part)})
            continue
        kind = part.get("type")
        if kind == "text":
            out.append({"type": "text", "text": part.get("text", "")})
        elif kind == "reasoning":
            out.append({"type": "reasoning", "text": part.get("text", "")})
        elif kind == "tool":
            state = part.get("state") or {}
            out.append({
                "type": "tool_call",
                "id": part.get("id"),
                "name": part.get("name"),
                "status": state.get("status"),
                "input": state.get("input"),
                "output": cap_text(state.get("output")),
            })
        else:
            out.append(part)
    return out


def ingest_opencode_session(con, sess, state: dict, dry_run: bool) -> dict:
    result = {"id": sess["id"], "turns": 0, "created": 0, "skipped": False}
    count, max_seq = con.execute(
        "select count(*), coalesce(max(seq), 0) from session_message where session_id = ?",
        (sess["id"],),
    ).fetchone()
    count, max_seq = int(count or 0), int(max_seq or 0)
    if not count:
        result["skipped"] = True
        return result

    prev = state["sessions"].get(sess["id"]) or {}
    if prev.get("count") == count and prev.get("seq") == max_seq:
        result["skipped"] = True
        return result

    turns: list = []
    models: list = []
    tally = [0]

    for kind, seq, ts_ms, data in con.execute(
        "select type, seq, time_created, data from session_message"
        " where session_id = ? order by seq",
        (sess["id"],),
    ):
        try:
            payload = json.loads(data)
        except json.JSONDecodeError:
            continue

        role = _OPENCODE_ROLES.get(kind, "event")
        if kind == "assistant":
            parts = opencode_parts(payload.get("content"))
        elif kind == "compaction":
            parts = [{"type": "text", "text": cap_text(payload.get("summary") or "")}]
        elif kind in _EVENT_TYPES:
            parts = [{"type": "event", "name": kind,
                      "data": {k: v for k, v in payload.items() if k != "time"}}]
        else:
            parts = [{"type": "text", "text": payload.get("text") or ""}]

        doc = {"v": 1, "role": role, "content": parts}
        if kind == "compaction":
            doc["status"] = payload.get("status")
            doc["reason"] = payload.get("reason")
        doc = {k: v for k, v in doc.items() if v is not None}
        digest, created = store_message(redact_obj(doc, tally), dry_run)
        result["created"] += 1 if created else 0

        turn = {"i": len(turns), "seq": seq, "ts": ms_to_iso(ts_ms), "role": role, "msg": digest}
        if kind == "assistant":
            model = payload.get("model") or {}
            turn.update({
                "model": model.get("id"),
                "provider": model.get("providerID"),
                "variant": model.get("variant"),
                "agent": payload.get("agent"),
                "cost_usd": payload.get("cost"),
            })
            if model.get("id") and model["id"] not in models:
                models.append(model["id"])
        turns.append({k: v for k, v in turn.items() if v is not None})
        result["turns"] += 1

    chained = chain_turns(turns, sess["id"])
    started = ms_to_iso(sess["time_created"])
    manifest = {
        "v": 1,
        "id": sess["id"],
        "harness": "opencode",
        "parent": sess["parent_id"],
        "started": started,
        "ended": ms_to_iso(sess["time_updated"]) or (turns[-1]["ts"] if turns else started),
        "cwd": sess["directory"],
        "title": sess["title"],
        "agent": sess["agent"],
        "models": models or ([sess["model"]] if sess["model"] else []),
        "turns": len(chained),
        "usage": {
            "input": int(sess["tokens_input"] or 0),
            "output": int(sess["tokens_output"] or 0),
            "cache_read": int(sess["tokens_cache_read"] or 0),
            "cache_write": int(sess["tokens_cache_write"] or 0),
            "reasoning": int(sess["tokens_reasoning"] or 0),
        },
        "cost_usd": round(float(sess["cost"] or 0), 6),
        "redactions": tally[0],
        "retention": "hot",
        "source": {"db": str(OPENCODE_DB), "session_id": sess["id"],
                   "seq": max_seq, "count": count},
    }
    write_session("opencode", sess["id"], manifest, chained, dry_run)
    result["count"] = count
    result["seq"] = max_seq
    return result


# ------------------------------------------------------------------ hermes --
#
# hermes never rewrites a message's content. Compaction flags the originals
# (`active=0, compacted=0`) and clones the carried tail under fresh ids
# (hermes_state_messages.py), so the archive can keep a plain snapshot of every
# row and still preserve what compaction did: the originals are still there,
# flagged, and the clones carry new ids.
#
# Two consequences drive the code below. The watermark must hash the flags as
# well as the content, because flags change without content changing. And the
# system prompt is not in `messages` at all — only a hash is on the session row,
# with the text in `system_prompts`, so it is joined and stored as its own
# content-addressed message.

_HERMES_SQL = """
select id, role, content, tool_calls, tool_call_id, tool_name, api_content,
       reasoning_content, timestamp, token_count, finish_reason,
       active, compacted, display_order
  from messages where session_id = ? order by id
"""


def sec_to_iso(value) -> str | None:
    if not value:
        return None
    return dt.datetime.fromtimestamp(float(value), dt.timezone.utc).isoformat(timespec="milliseconds")


def hermes_digest(rows) -> str:
    """Hash everything that can change without a row being added."""
    seen = []
    for r in rows:
        seen.append([
            r["id"],
            hashlib.sha256((r["content"] or "").encode()).hexdigest()[:16],
            hashlib.sha256((r["tool_calls"] or "").encode()).hexdigest()[:16],
            hashlib.sha256((r["api_content"] or "").encode()).hexdigest()[:16],
            int(r["active"] or 0),
            int(r["compacted"] or 0),
        ])
    return hashlib.sha256(canonical(seen).encode()).hexdigest()


def ingest_hermes_session(con, sess, state: dict, dry_run: bool) -> dict:
    sid = sess["id"]
    result = {"id": sid, "turns": 0, "created": 0, "skipped": False}

    rows = con.execute(_HERMES_SQL, (sid,)).fetchall()
    if not rows:
        result["skipped"] = True
        return result

    digest = hermes_digest(rows)
    prev = state["sessions"].get(sid) or {}
    if prev.get("digest") == digest:
        result["skipped"] = True
        return result

    turns: list = []
    tally = [0]
    started = sec_to_iso(sess["started_at"]) or sec_to_iso(rows[0]["timestamp"])

    # The system prompt comes from `system_prompts` by hash, not from `messages`.
    prompt_hash = sess["system_prompt_hash"]
    if prompt_hash:
        hit = con.execute(
            "select prompt from system_prompts where hash = ?", (prompt_hash,)
        ).fetchone()
        if hit and hit["prompt"]:
            doc = redact_obj({"v": 1, "role": "system",
                              "content": [{"type": "text", "text": hit["prompt"]}]}, tally)
            msg, created = store_message(doc, dry_run)
            result["created"] += 1 if created else 0
            turns.append({"i": 0, "ts": started, "role": "system", "msg": msg,
                          "synthetic": True, "prompt_hash": prompt_hash})
            result["turns"] += 1

    for r in rows:
        role = r["role"] or "unknown"
        parts = [{"type": "text", "text": (cap_text(r["content"]) if role == "tool" else (r["content"] or ""))}]
        if r["reasoning_content"]:
            parts.append({"type": "reasoning", "text": r["reasoning_content"]})

        doc = {"v": 1, "role": role, "content": parts}
        if r["tool_calls"]:
            try:
                doc["tool_calls"] = json.loads(r["tool_calls"])
            except json.JSONDecodeError:
                doc["tool_calls_raw"] = r["tool_calls"]
        if r["tool_call_id"]:
            doc["tool_call_id"] = r["tool_call_id"]
        if r["tool_name"]:
            doc["tool_name"] = r["tool_name"]
        if r["api_content"]:
            # Byte-fidelity sidecar: the exact string sent to the API when it
            # differed from `content` (hermes_state_messages.py).
            doc["api_content"] = cap_text(r["api_content"])
        doc = {k: v for k, v in doc.items() if v is not None}

        msg, created = store_message(redact_obj(doc, tally), dry_run)
        result["created"] += 1 if created else 0

        turn = {
            "i": len(turns),
            "src_id": r["id"],
            "ts": sec_to_iso(r["timestamp"]),
            "role": role,
            "msg": msg,
            "active": int(r["active"] or 0),
            "compacted": int(r["compacted"] or 0),
        }
        if r["display_order"] is not None:
            turn["display_order"] = r["display_order"]
        if r["token_count"]:
            turn["tokens"] = r["token_count"]
        if r["finish_reason"]:
            turn["finish_reason"] = r["finish_reason"]
        turns.append(turn)
        result["turns"] += 1

    chained = chain_turns(turns, sid)
    manifest = {
        "v": 1,
        "id": sid,
        "harness": "hermes",
        "parent": sess["parent_session_id"],
        "started": started,
        "ended": sec_to_iso(sess["ended_at"]) or sec_to_iso(rows[-1]["timestamp"]),
        "cwd": sess["cwd"],
        "title": sess["title"],
        "git_branch": sess["git_branch"],
        "model": sess["model"],
        "model_config": sess["model_config"],
        "system_prompt_hash": prompt_hash,
        "turns": len(chained),
        "usage": {
            "input": int(sess["input_tokens"] or 0),
            "output": int(sess["output_tokens"] or 0),
            "cache_read": int(sess["cache_read_tokens"] or 0),
            "cache_write": int(sess["cache_write_tokens"] or 0),
            "reasoning": int(sess["reasoning_tokens"] or 0),
        },
        "cost_usd": round(float(sess["actual_cost_usd"] or sess["estimated_cost_usd"] or 0), 6),
        "cost_source": sess["cost_source"],
        "redactions": tally[0],
        "retention": "hot",
        "source": {"db": str(HERMES_DB), "session_id": sid,
                   "messages": len(rows), "digest": digest},
    }
    write_session("hermes", sid, manifest, chained, dry_run)
    result["digest"] = digest
    return result


# ----------------------------------------------------------------- osaurus --
#
# osaurus is the only harness whose log already contains the wire bodies
# (`wireRequestBody` / `wireResponseBody`), so nothing here has to reconstruct
# what was sent. It is also the only one that streams: most responses are SSE
# with `data: [DONE]`, so the parser reassembles deltas rather than reading a
# `choices[0].message`.
#
# Two filters matter. `/internal/...` paths are utility calls (chat titles,
# memory distillation) with synthetic prompts, not conversation. And Chat UI
# rows carry no `session_id` — their conversation identity is the first segment
# of `request_id` (`<chat-uuid>:<turn>:r0-...`), which is what groups them.

_OSAURUS_SQL = """
select seq, ts_ms, source, path, status, model, provider_id, agent_id, agent_name,
       session_id, turn_id, request_id, input_tokens, output_tokens, duration_ms,
       error_message, payload
  from activity
 where category = 'inference' and path not like '/internal/%'
 order by seq
"""


def osaurus_session_key(row) -> str | None:
    if row["session_id"]:
        return row["session_id"]
    rid = row["request_id"] or ""
    if ":" in rid:
        return "chat-" + rid.split(":", 1)[0].lower()
    return None


def openai_parts(msg: dict) -> list:
    """Normalise an OpenAI-shaped message, as found in a request body."""
    parts = []
    content = msg.get("content")
    if isinstance(content, str) and content:
        parts.append({"type": "text", "text": cap_text(content)})
    elif isinstance(content, list):
        for part in content:
            if isinstance(part, dict) and part.get("type") == "text":
                parts.append({"type": "text", "text": part.get("text", "")})
            elif isinstance(part, dict):
                parts.append(part)
    if msg.get("reasoning_content"):
        parts.append({"type": "reasoning", "text": msg["reasoning_content"]})
    for call in msg.get("tool_calls") or []:
        fn = call.get("function") or {}
        parts.append({"type": "tool_call", "id": call.get("id"),
                      "name": fn.get("name"), "arguments": fn.get("arguments")})
    return parts


def parse_osaurus_completion(body) -> dict:
    """Reassemble a completion from a JSON body or an SSE stream."""
    text = (body or "").strip()
    if not text:
        return {"parts": [], "usage": None, "finish_reason": None}

    if not text.startswith("data:"):
        try:
            obj = json.loads(text)
        except json.JSONDecodeError:
            return {"parts": [{"type": "text", "text": cap_text(text)}],
                    "usage": None, "finish_reason": None, "raw": True}
        choices = obj.get("choices") or []
        if not choices:
            return {"parts": [], "usage": obj.get("usage"), "finish_reason": None}
        msg = choices[0].get("message") or {}
        return {"parts": openai_parts(msg), "usage": obj.get("usage"),
                "finish_reason": choices[0].get("finish_reason")}

    said: list = []
    tools: dict = {}
    usage = None
    finish = None
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("data:"):
            continue
        chunk = line[5:].strip()
        if not chunk or chunk == "[DONE]":
            continue
        try:
            obj = json.loads(chunk)
        except json.JSONDecodeError:
            continue  # a body truncated at the 256 KiB cap ends mid-chunk
        if obj.get("usage"):
            usage = obj["usage"]
        for choice in obj.get("choices") or []:
            delta = choice.get("delta") or {}
            if delta.get("content"):
                said.append(delta["content"])
            # Providers disagree on the key: OpenAI-compatible ones use
            # `reasoning_content`, OpenRouter-shaped ones use `reasoning`.
            reasoning_delta = delta.get("reasoning_content") or delta.get("reasoning")
            if reasoning_delta:
                tools.setdefault("_reasoning", []).append(reasoning_delta)
            for call in delta.get("tool_calls") or []:
                slot = tools.setdefault(call.get("index", 0),
                                        {"id": None, "name": None, "arguments": ""})
                if call.get("id"):
                    slot["id"] = call["id"]
                fn = call.get("function") or {}
                if fn.get("name"):
                    slot["name"] = fn["name"]
                if fn.get("arguments"):
                    slot["arguments"] += fn["arguments"]
            if choice.get("finish_reason"):
                finish = choice["finish_reason"]

    parts = []
    reasoning = tools.pop("_reasoning", None)
    if reasoning:
        parts.append({"type": "reasoning", "text": "".join(reasoning)})
    if said:
        parts.append({"type": "text", "text": "".join(said)})
    for _, slot in sorted(tools.items()):
        parts.append({"type": "tool_call", "id": slot["id"], "name": slot["name"],
                      "arguments": slot["arguments"]})
    # An SSE body that never reached `[DONE]` was cut at the 256 KiB capture
    # cap. Say so on the record: a truncated answer that looks complete is
    # worse than one that admits it.
    truncated = not text.rstrip().endswith("[DONE]")
    return {"parts": parts, "usage": usage, "finish_reason": finish,
            "truncated": truncated}


def ingest_osaurus_session(rows, key: str, state: dict, dry_run: bool) -> dict:
    result = {"id": key, "turns": 0, "created": 0, "skipped": False, "count": len(rows),
              "seq": max(int(r["seq"]) for r in rows)}
    prev = state["sessions"].get(key) or {}
    if prev.get("count") == result["count"] and prev.get("seq") == result["seq"]:
        result["skipped"] = True
        return result

    turns: list = []
    models: list = []
    sources: list = []
    tally = [0]
    usage = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "reasoning": 0}
    duration = 0.0
    last_digest = None
    system_stored = False

    for row in rows:
        try:
            payload = json.loads(row["payload"])
        except json.JSONDecodeError:
            continue
        if row["source"] and row["source"] not in sources:
            sources.append(row["source"])

        body = payload.get("wireRequestBody") or payload.get("requestBody") or ""
        try:
            request = json.loads(body) if body else {}
        except json.JSONDecodeError:
            request = {}
        messages = request.get("messages") or []

        # The system prompt is the same on every call in a session; store once.
        if messages and messages[0].get("role") == "system" and not system_stored:
            doc = {"v": 1, "role": "system", "content": openai_parts(messages[0])}
            msg, created = store_message(redact_obj(doc, tally), dry_run)
            result["created"] += 1 if created else 0
            turns.append({"i": 0, "ts": ms_to_iso(row["ts_ms"]), "role": "system",
                          "msg": msg, "synthetic": True})
            system_stored = True
            last_digest = msg
            result["turns"] += 1

        # And the message that triggered this call is the last one in the array.
        if messages:
            prompt = messages[-1]
            doc = {"v": 1, "role": prompt.get("role") or "user",
                   "content": openai_parts(prompt)}
            if prompt.get("tool_call_id"):
                doc["tool_call_id"] = prompt["tool_call_id"]
            doc = {k: v for k, v in doc.items() if v is not None}
            digest, created = store_message(redact_obj(doc, tally), dry_run)
            result["created"] += 1 if created else 0
            if digest != last_digest:
                turns.append({"i": len(turns), "ts": ms_to_iso(row["ts_ms"]),
                              "role": doc["role"], "msg": digest})
                last_digest = digest
                result["turns"] += 1

        completion = parse_osaurus_completion(
            payload.get("wireResponseBody") or payload.get("responseBody"))
        doc = {"v": 1, "role": "assistant", "content": completion["parts"]}
        if completion.get("raw"):
            doc["raw"] = True
        if completion.get("truncated"):
            doc["truncated"] = True
        doc = {k: v for k, v in doc.items() if v is not None}
        digest, created = store_message(redact_obj(doc, tally), dry_run)
        result["created"] += 1 if created else 0

        model = payload.get("model") or row["model"]
        if model and model not in models:
            models.append(model)
        spend = completion.get("usage") or {}
        usage["input"] += int(spend.get("prompt_tokens") or payload.get("inputTokens") or 0)
        usage["output"] += int(spend.get("completion_tokens") or payload.get("outputTokens") or 0)
        cached = (spend.get("prompt_tokens_details") or {}).get("cached_tokens")
        if cached:
            usage["cache_read"] += int(cached)
        if payload.get("durationMs"):
            duration += float(payload["durationMs"])

        turn = {
            "i": len(turns),
            "seq": int(row["seq"]),
            "ts": ms_to_iso(row["ts_ms"]),
            "role": "assistant",
            "msg": digest,
            "model": model,
            "provider": row["provider_id"],
            "path": row["path"],
            "status": row["status"],
            "duration_ms": round(float(row["duration_ms"]), 1) if row["duration_ms"] else None,
            "finish_reason": completion.get("finish_reason"),
            "prompt_messages": len(messages),
            "truncated": completion.get("truncated"),
        }
        turns.append({k: v for k, v in turn.items() if v is not None})
        last_digest = digest
        result["turns"] += 1

    chained = chain_turns(turns, key)
    first = rows[0]
    manifest = {
        "v": 1,
        "id": key,
        "harness": "osaurus",
        "started": ms_to_iso(first["ts_ms"]),
        "ended": ms_to_iso(rows[-1]["ts_ms"]),
        "agent_id": first["agent_id"],
        "agent_name": first["agent_name"],
        "sources": sources,
        "models": models,
        "calls": len(rows),
        "turns": len(chained),
        "usage": usage,
        "avg_duration_ms": round(duration / len(rows), 1) if rows else None,
        "redactions": tally[0],
        "retention": "hot",
        "source": {"db": str(OSAURUS_DB), "category": "inference",
                   "seq": result["seq"], "count": result["count"]},
    }
    write_session("osaurus", key, manifest, chained, dry_run)
    return result


def _ingest_state(harness: str) -> tuple[pathlib.Path, dict]:
    path = RAW_DIR / "state" / f"{harness}.json"
    state = {"v": 1, "sessions": {}}
    if path.exists():
        try:
            state = json.loads(path.read_text())
        except json.JSONDecodeError:
            die(f"corrupt ingest state at {path}; move it aside to rebuild", 1)
    state.setdefault("sessions", {})
    return path, state


def _finish_ingest(harness, args, state_path, state, processed, turns, created, skipped) -> int:
    # Only touch state when something changed, so a no-op run leaves the archive
    # repo clean — that is what makes `git status` usable as an idempotence check.
    if not args.dry_run and processed:
        state["updated"] = dt.datetime.now().isoformat(timespec="seconds")
        write_atomic(state_path, json.dumps(state, indent=2, sort_keys=True) + "\n")
    verb = "would ingest" if args.dry_run else "ingested"
    print(f"mem: {verb} {processed} {harness} session(s): {turns} turn(s), "
          f"{created} new message(s), {skipped} unchanged")
    print(f"mem: archive at {RAW_DIR}")
    return 0


def _ingest_pi(args) -> int:
    if not PI_SESSIONS.is_dir():
        die(f"no pi sessions at {PI_SESSIONS}", 1)
    state_path, state = _ingest_state("pi")
    processed = skipped = turns = created = 0
    for path in sorted(PI_SESSIONS.rglob("*.jsonl")):
        result = ingest_pi_session(path, state, args.dry_run)
        if result["skipped"]:
            skipped += 1
            continue
        processed += 1
        turns += result["turns"]
        created += result["created"]
        if not args.dry_run:
            st = path.stat()
            state["sessions"][str(path)] = {
                "size": st.st_size,
                "mtime_ns": st.st_mtime_ns,
                "id": result["id"],
                "updated": dt.datetime.now().isoformat(timespec="seconds"),
            }
    return _finish_ingest("pi", args, state_path, state, processed, turns, created, skipped)


def _ingest_opencode(args) -> int:
    if not OPENCODE_DB.exists():
        die(f"no opencode database at {OPENCODE_DB}", 1)
    state_path, state = _ingest_state("opencode")
    processed = skipped = turns = created = 0
    con = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            "select id, parent_id, directory, title, agent, model, cost,"
            " tokens_input, tokens_output, tokens_reasoning,"
            " tokens_cache_read, tokens_cache_write, time_created, time_updated"
            # session_v2, not session: V1 stopped being written on 2026-09-30
            # while V2 kept going, and messages are keyed to V2 ids. Reading V1
            # silently archived a month-stale subset (479 of 518 sessions).
            " from session_v2 order by time_created"
        ).fetchall()
        for sess in rows:
            result = ingest_opencode_session(con, sess, state, args.dry_run)
            if result["skipped"]:
                skipped += 1
                continue
            processed += 1
            turns += result["turns"]
            created += result["created"]
            if not args.dry_run:
                state["sessions"][sess["id"]] = {
                    "count": result.get("count"),
                    "seq": result.get("seq"),
                    "updated": dt.datetime.now().isoformat(timespec="seconds"),
                }
    finally:
        con.close()
    return _finish_ingest("opencode", args, state_path, state, processed, turns, created, skipped)


def _ingest_hermes(args) -> int:
    if not HERMES_DB.exists():
        die(f"no hermes database at {HERMES_DB}", 1)
    state_path, state = _ingest_state("hermes")
    processed = skipped = turns = created = 0
    try:
        con = sqlite3.connect(f"file:{HERMES_DB}?mode=ro", uri=True, timeout=10)
    except sqlite3.Error as exc:
        die(f"cannot open {HERMES_DB}: {exc}", 1)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            "select id, parent_session_id, cwd, title, git_branch, model, model_config,"
            " system_prompt_hash, started_at, ended_at, input_tokens, output_tokens,"
            " cache_read_tokens, cache_write_tokens, reasoning_tokens,"
            " estimated_cost_usd, actual_cost_usd, cost_source"
            " from sessions order by started_at"
        ).fetchall()
        for sess in rows:
            try:
                result = ingest_hermes_session(con, sess, state, args.dry_run)
            except sqlite3.OperationalError as exc:
                # A lock means another writer holds the lease. Fail the run
                # rather than skip: a silently skipped session is invisible,
                # a failed ingest is not.
                die(f"hermes database unavailable mid-run ({exc}); rerun when idle", 1)
            if result["skipped"]:
                skipped += 1
                continue
            processed += 1
            turns += result["turns"]
            created += result["created"]
            if not args.dry_run:
                state["sessions"][sess["id"]] = {
                    "digest": result.get("digest"),
                    "updated": dt.datetime.now().isoformat(timespec="seconds"),
                }
    finally:
        con.close()
    return _finish_ingest("hermes", args, state_path, state, processed, turns, created, skipped)


def _ingest_osaurus(args) -> int:
    if not OSAURUS_DB.exists():
        die(f"no osaurus activity database at {OSAURUS_DB}", 1)
    state_path, state = _ingest_state("osaurus")
    processed = skipped = turns = created = 0
    con = sqlite3.connect(f"file:{OSAURUS_DB}?mode=ro", uri=True, timeout=10)
    con.row_factory = sqlite3.Row
    try:
        buckets: dict = {}
        for row in con.execute(_OSAURUS_SQL):
            key = osaurus_session_key(row)
            if key is None:
                continue
            buckets.setdefault(key, []).append(row)
        for key in sorted(buckets, key=lambda k: buckets[k][0]["seq"]):
            result = ingest_osaurus_session(buckets[key], key, state, args.dry_run)
            if result["skipped"]:
                skipped += 1
                continue
            processed += 1
            turns += result["turns"]
            created += result["created"]
            if not args.dry_run:
                state["sessions"][key] = {
                    "count": result["count"],
                    "seq": result["seq"],
                    "updated": dt.datetime.now().isoformat(timespec="seconds"),
                }
    finally:
        con.close()
    return _finish_ingest("osaurus", args, state_path, state, processed, turns, created, skipped)


def cmd_ingest(args) -> int:
    if args.harness == "pi":
        return _ingest_pi(args)
    if args.harness == "opencode":
        return _ingest_opencode(args)
    if args.harness == "hermes":
        return _ingest_hermes(args)
    if args.harness == "osaurus":
        return _ingest_osaurus(args)
    die(f"no importer for {args.harness} (available: pi, opencode, hermes, osaurus)", 2)


# ----------------------------------------------------------------- query --
#
# No index. Measured on the real archive: an `rg` sweep of 51,536 files takes
# ~1.1 s, and the digest -> location map builds in 0.32 s, so archive recall is
# ~1.4 s end to end. An FTS table would cut that to tens of milliseconds and add
# a rebuild step and a staleness class for a query an agent runs a few times a
# session. The scan is ~15 s at 2 GB — that is the point to revisit, and it is
# the same trigger as packing.

_MESSAGES = RAW_DIR / "messages"


def message_path(digest: str) -> pathlib.Path:
    return _MESSAGES / digest[:2] / f"{digest}.json"


def message_text(digest: str) -> str:
    path = message_path(digest)
    if not path.exists():
        return ""
    try:
        doc = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return ""
    chunks = []
    for part in doc.get("content") or []:
        kind = part.get("type")
        if kind in ("text", "reasoning"):
            chunks.append(part.get("text") or "")
        elif kind == "tool_call":
            args = part.get("arguments") or part.get("input")
            chunks.append(f"{part.get('name')}({args if isinstance(args, str) else canonical(args)})")
    return "\n".join(c for c in chunks if c)


def archive_index() -> dict:
    """digest -> [(harness, session, ts, role)] over the whole archive."""
    index: dict = {}
    for f in RAW_DIR.glob("sessions/*/*/*/*/turns.jsonl"):
        harness = f.parts[-5]
        session = f.parent.name
        try:
            lines = f.read_text().splitlines()
        except OSError:
            continue
        for line in lines:
            if not line.strip():
                continue
            turn = json.loads(line)
            index.setdefault(turn["msg"], []).append(
                (harness, session, turn.get("ts") or "", turn.get("role") or ""))
    return index


def archive_session_ids() -> list:
    return sorted(p.parent.name for p in RAW_DIR.glob("sessions/*/*/*/*/session.json"))


def recall_archive(words, days, limit) -> list:
    """Search the archived messages, then resolve them to sessions and turns."""
    if not _MESSAGES.is_dir():
        return []
    pattern = "|".join(re.escape(w) for w in words)
    proc = subprocess.run(
        ["rg", "-l", "-i", "--no-messages", "--", pattern, str(_MESSAGES)],
        capture_output=True, text=True)
    digests = [pathlib.Path(line).stem for line in proc.stdout.splitlines() if line.strip()]
    if not digests:
        return []
    cutoff = (dt.datetime.now() - dt.timedelta(days=days)).isoformat()[:19]
    index = archive_index()
    by_session: dict = {}
    for digest in digests:
        for harness, session, ts, role in index.get(digest, []):
            if ts and ts[:19] < cutoff:
                continue
            text = message_text(digest)
            if not text:
                continue
            lower = text.lower()
            by_session.setdefault((harness, session), []).append({
                "when": ts or "",
                "source": f"archive/{harness}",
                "session": session,
                "role": role,
                "text": _snippet(text, words, width=200),
                "digest": digest,
                "score": sum(1 for word in words if word.lower() in lower),
            })
    # Cap while collecting, not after: truncating first let one long session
    # take every slot, because it is both the largest and the most recent.
    hits = []
    for group in by_session.values():
        group.sort(key=lambda h: (h["score"], h["when"]), reverse=True)
        hits.extend(group[:2])
    return hits


# MEM_DOCS points the curated search at a fixture, the same way MEMORY_RAW does.
_DOC_ENV = os.environ.get("MEM_DOCS")
DOC_ROOTS = (
    (("docs", pathlib.Path(_DOC_ENV)),) if _DOC_ENV else (
        ("learnings", HOME / "docs" / "learnings"),
        ("plans", HOME / "docs" / "plans"),
        ("decisions", HOME / "DECISIONS.md"),
    )
)


def recall_docs(words, days, limit, include_archive=False) -> list:
    """Search the curated markdown: the distilled layer, not the transcripts.

    Separate root rather than extra content in the archive: a learnings entry and
    the session that produced it *should* both match a query — that is the
    provenance chain, not duplication — so the two are labelled and merged.
    """
    roots = [(label, root) for label, root in DOC_ROOTS if root.exists()]
    if include_archive:
        roots.append(("archive", HOME / "docs" / "archive"))
    if not roots:
        return []

    pattern = "|".join(re.escape(w) for w in words)
    cutoff = (dt.date.today() - dt.timedelta(days=days)).isoformat()
    hits = []
    for label, root in roots:
        proc = subprocess.run(
            ["rg", "-l", "-i", "--no-messages", "--", pattern, str(root)],
            capture_output=True, text=True)
        for found in proc.stdout.splitlines():
            if not found.strip():
                continue
            path = pathlib.Path(found)
            # An index file is a list of links; a hit there points at a lesson
            # without being one.
            if path.name == "README.md":
                continue
            stamped = re.match(r"(\d{4}-\d{2}-\d{2})", path.name)
            when = stamped.group(1) if stamped else dt.date.fromtimestamp(
                path.stat().st_mtime).isoformat()
            if when < cutoff:
                continue
            body = path.read_text()
            text = ""
            for line in body.splitlines():
                if all(word.lower() in line.lower() for word in words):
                    text = _snippet(line, words, width=200)
                    break
            lower = body.lower()
            hits.append({
                "when": when,
                "source": f"docs/{label}",
                "session": path.stem,
                "role": "",
                "text": text or _snippet(body[:4000], words, width=200),
                "score": sum(1 for word in words if word.lower() in lower),
            })
    return hits


def anchor_text(anchor: str) -> str:
    """Resolve an anchor to readable text. Raises ValueError rather than exiting,
    so the MCP server can return an error to the model instead of dying."""
    raw = anchor[len("session://"):] if anchor.startswith("session://") else anchor
    match = re.match(r"^(?P<harness>[\w-]+)/(?P<session>[^#]+)(?:#turn-(?P<turn>\d+))?$", raw)
    if not match:
        raise ValueError("anchor should look like session://<harness>/<session-id>#turn-N")
    harness, session, turn_no = match.group("harness"), match.group("session"), match.group("turn")

    found = list(RAW_DIR.glob(f"sessions/{harness}/*/*/{session}/turns.jsonl"))
    if not found:
        raise ValueError(f"no archived session {harness}/{session}")
    turns = [json.loads(line) for line in found[0].read_text().splitlines() if line.strip()]
    if turn_no is not None:
        picked = [t for t in turns if str(t.get("i")) == turn_no]
        if not picked:
            raise ValueError(f"turn {turn_no} not in {harness}/{session} (has {len(turns)})")
        turns = picked

    manifest = json.loads((found[0].parent / "session.json").read_text())
    out = [f"{harness}/{session}  {manifest.get('started', '')[:19]}  "
           f"{manifest.get('models') or manifest.get('model') or ''}"]
    for turn in turns:
        out.append(f"\n[{turn.get('i')}] {turn.get('role')}  {str(turn.get('ts'))[:19]}")
        if turn.get("model"):
            out.append(f"    model={turn['model']} tokens={turn.get('tokens')} "
                       f"cost={turn.get('cost_usd')} {('truncated' if turn.get('truncated') else '')}")
        text = message_text(turn["msg"])
        out.append("\n".join("    " + line for line in text.splitlines()[:60]) or "    (empty)")
    return "\n".join(out)


def show_anchor(anchor: str) -> int:
    try:
        print(anchor_text(anchor))
    except ValueError as exc:
        die(str(exc), 1)
    return 0


# -------------------------------------------------------------------- mcp --
#
# Osaurus can spawn a stdio MCP command on the host; verified 2026-10-26 with a
# probe that read all three memory paths as uid 501. That makes this the one
# integration that gives it the archive, without copying anything into its own
# memory store (which would duplicate, double-distil and decay).
#
# Read-only on purpose. The client called the probe tool twice in one session; a
# read is idempotent, a write would have filed the same lesson twice. Capture
# already flows from Osaurus through activity.sqlite ingestion.

MCP_TOOLS = [
    {
        "name": "recall",
        "description": (
            "Search Scott's accumulated memory before re-deriving an answer: every archived "
            "session from pi, opencode, hermes and osaurus, plus the curated notes in "
            "~/docs/learnings. Returns hits with session ids and [turn-N] anchors."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "words to look for"},
                "days": {"type": "integer", "description": "how far back (default 365)"},
                "limit": {"type": "integer", "description": "hits per source (default 6)"},
                "source": {"type": "string", "enum": ["all", "archive", "docs"]},
            },
            "required": ["query"],
        },
    },
    {
        "name": "show",
        "description": (
            "Print the turns of an archived session by anchor, e.g. "
            "session://opencode/ses_abc#turn-12, to check the evidence behind a recall hit."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {"anchor": {"type": "string"}},
            "required": ["anchor"],
        },
    },
    {
        "name": "learnings",
        "description": "List the curated domain lessons in ~/docs/learnings: date, slug and title.",
        "inputSchema": {"type": "object", "properties": {}},
    },
]


def mcp_recall(arguments: dict) -> str:
    words = _words(str(arguments.get("query") or ""))
    if not words:
        raise ValueError("query is required")
    days = int(arguments.get("days") or 365)
    limit = int(arguments.get("limit") or 6)
    source = str(arguments.get("source") or "all")
    hits = []
    if source in ("all", "archive") and (RAW_DIR / "messages").is_dir():
        hits.extend(recall_archive(words, days, limit))
    if source in ("all", "docs"):
        hits.extend(recall_docs(words, days, limit, False))
    curated = sorted((h for h in hits if h["source"].startswith("docs/")),
                     key=lambda h: (h.get("score", 0), h["when"]), reverse=True)
    evidence = sorted((h for h in hits if not h["source"].startswith("docs/")),
                      key=lambda h: (h.get("score", 0), h["when"]), reverse=True)
    lines = []
    for group, cap in ((curated, limit), (evidence, limit * 2)):
        for h in group[:cap]:
            role = f" ({h['role']})" if h.get("role") else ""
            lines.append(f"{h['when'][:16]}  {h['source']}  {h['session']}{role}")
            lines.append(f"    {h['text']}")
    if not lines:
        return f"Nothing matching {' '.join(words)}."
    return "\n".join(lines)


def mcp_learnings(_arguments: dict) -> str:
    rows = []
    for path in sorted((HOME / "docs" / "learnings").glob("*.md")):
        if path.name == "README.md":
            continue
        title = ""
        for line in path.read_text().splitlines():
            if line.startswith("# "):
                title = line[2:].strip()
                break
        rows.append(f"{path.name[:10]}  {path.stem}  {title}")
    return "\n".join(rows) or "No learnings recorded."


def mcp_call(name: str, arguments: dict) -> dict:
    handler = {"recall": mcp_recall, "learnings": mcp_learnings}.get(name)
    try:
        if name == "show":
            text = anchor_text(str(arguments.get("anchor") or ""))
        elif handler:
            text = handler(arguments)
        else:
            return {"content": [{"type": "text", "text": f"unknown tool {name}"}],
                    "isError": True}
    except ValueError as exc:
        return {"content": [{"type": "text", "text": str(exc)}], "isError": True}
    return {"content": [{"type": "text", "text": text}]}


def cmd_mcp(_args) -> int:
    out = sys.stdout.buffer

    def send(payload: dict, framed: bool) -> None:
        body = json.dumps(payload).encode()
        out.write((b"Content-Length: %d\r\n\r\n" % len(body) + body) if framed else body + b"\n")
        out.flush()

    while True:
        line = sys.stdin.buffer.readline()
        if not line:
            return 0
        framed = line.lower().startswith(b"content-length:")
        if framed:
            try:
                length = int(line.split(b":", 1)[1].strip())
            except ValueError:
                continue
            while True:
                header = sys.stdin.buffer.readline()
                if header in (b"\r\n", b"\n", b""):
                    break
            payload = sys.stdin.buffer.read(length).decode("utf-8", "replace")
        else:
            payload = line.decode("utf-8", "replace").strip()
            if not payload:
                continue

        try:
            message = json.loads(payload)
        except json.JSONDecodeError:
            continue

        method = message.get("method")
        ident = message.get("id")

        if method == "initialize":
            send({"jsonrpc": "2.0", "id": ident, "result": {
                "protocolVersion": (message.get("params") or {}).get("protocolVersion", "2024-11-05"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "mem", "version": "1.0.0"}}}, framed)
        elif method in ("notifications/initialized", "notifications/cancelled"):
            continue
        elif method == "tools/list":
            send({"jsonrpc": "2.0", "id": ident, "result": {"tools": MCP_TOOLS}}, framed)
        elif method == "tools/call":
            params = message.get("params") or {}
            send({"jsonrpc": "2.0", "id": ident,
                  "result": mcp_call(str(params.get("name") or ""),
                                     params.get("arguments") or {})}, framed)
        elif method == "ping":
            send({"jsonrpc": "2.0", "id": ident, "result": {}}, framed)
        elif ident is not None:
            send({"jsonrpc": "2.0", "id": ident,
                  "error": {"code": -32601, "message": f"unknown method {method}"}}, framed)


# ------------------------------------------------------------- summarize --


# ------------------------------------------------------------- summarize --
#
# The only command in `mem` that touches the network. Everything else is files.
#
# Design notes from the phase-4 spike (8 substantial sessions, 10 trivial ones):
#   - anchors work: every [turn-N] the model emitted resolved, across 8 sessions
#   - shortening the transcript is lossy, not free: a 4,121-turn session
#     summarized its first portion and never saw the rest, so long sessions are
#     chunked and then consolidated
#   - the model *does* decline: 4 of 10 trivial sessions came back
#     `NO DURABLE LESSONS`, so "no lesson inflation" is enforceable
#   - turn count is a weak triage signal, since 6 of those 10 short sessions held
#     something real. Send sessions; let the model decline.
#   - 900 output tokens truncated most summaries; 1500 is the floor.

SUMMARIES = MEMORY_DIR / "summaries"
KEY_FILE = pathlib.Path(os.environ.get("MEM_DEEPINFRA_KEY_FILE", "/run/agenix/hermes-deepinfra"))
SUMMARY_MODEL = os.environ.get("MEM_SUMMARY_MODEL", "deepseek-ai/DeepSeek-V4.1-Flash-1017")
SUMMARY_URL = "https://api.deepinfra.com/v1/openai/chat/completions"
TRANSCRIPT_CHARS = 110_000
MESSAGE_CHARS = 1_400
DECLINE = "NO DURABLE LESSONS"

SUMMARY_PROMPT = """You summarize one recorded agent session so a future session can learn \
from it without rereading it.

Return markdown with these sections, omitting any with nothing to say:
## Goal
## What was tried
## What worked
## What failed
## Gotchas
## Dead ends

Rules:
- End every factual claim with an anchor like [turn-12] referring to the numbered turns.
- Quote exact error text where it matters.
- If the session holds nothing durable — no reusable fact, no surprise, no lesson
  worth a future session's context — reply with exactly `NO DURABLE LESSONS` and
  nothing else. Routine work that went as expected is not durable.
- Bullet points, no preamble."""

CONSOLIDATE_PROMPT = """Below are summaries of consecutive windows of one long agent \
session. Merge them into a single summary in the same format, keeping every
anchor exactly as written and dropping repetition.

Rules:
- Keep the same sections: ## Goal / ## What was tried / ## What worked /
  ## What failed / ## Gotchas / ## Dead ends.
- Keep [turn-N] anchors; do not invent new ones.
- If the windows together hold nothing durable, reply with exactly
  `NO DURABLE LESSONS`."""


def deepinfra_key() -> str:
    try:
        for line in KEY_FILE.read_text().splitlines():
            if line.startswith("DEEPINFRA_API_KEY="):
                return line.split("=", 1)[1].strip()
    except OSError as exc:
        die(f"cannot read {KEY_FILE}: {exc}", 1)
    die(f"no DEEPINFRA_API_KEY in {KEY_FILE}", 1)


def chat(key: str, system: str, user: str, max_tokens: int = 1500) -> tuple:
    import urllib.request

    payload = {
        "model": SUMMARY_MODEL,
        "max_tokens": max_tokens,
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": user}],
    }
    req = urllib.request.Request(
        SUMMARY_URL, data=json.dumps(payload).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            data = json.loads(resp.read())
    except Exception as exc:  # noqa: BLE001 - surfaced to the user, never retried
        die(f"summary request failed: {exc}", 1)
    usage = data.get("usage") or {}
    tin = int(usage.get("prompt_tokens") or 0)
    tout = int(usage.get("completion_tokens") or 0)
    text = (data.get("choices") or [{}])[0].get("message", {}).get("content", "") or ""
    return text.strip(), tin, tout


def summary_cost(tin: int, tout: int) -> float:
    # DeepSeek Flash list price: $0.20/M in, $0.60/M out.
    return tin / 1e6 * 0.20 + tout / 1e6 * 0.60


def summary_path(harness: str, session: str) -> pathlib.Path:
    return SUMMARIES / harness / f"{session}.md"


def stored_digest(path: pathlib.Path) -> str:
    if not path.exists():
        return ""
    for line in path.read_text().splitlines()[:12]:
        if line.startswith("source_digest:"):
            return line.split(":", 1)[1].strip()
        if line.startswith("---") and line != "---":
            continue
    return ""


def turn_text(digest: str) -> str:
    path = message_path(digest) if digest else None
    if not path or not path.exists():
        return ""
    try:
        doc = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return ""
    out = []
    for part in doc.get("content") or []:
        kind = part.get("type")
        if kind in ("text", "reasoning"):
            out.append(part.get("text") or "")
        elif kind == "tool_call":
            args = part.get("arguments") or part.get("input")
            out.append(f"{part.get('name')}({args if isinstance(args, str) else canonical(args)})")
    return "\n".join(o for o in out if o)[:MESSAGE_CHARS]


def transcript_windows(folder: pathlib.Path) -> list:
    """Split a session into windows that fit, preserving global turn numbers."""
    lines = []
    for line in (folder / "turns.jsonl").read_text().splitlines():
        if not line.strip():
            continue
        turn = json.loads(line)
        lines.append(f"[turn-{turn['i']}] {turn['role']}: {turn_text(turn['msg'])}")

    windows, current, size = [], [], 0
    for line in lines:
        if size + len(line) > TRANSCRIPT_CHARS and current:
            windows.append("\n\n".join(current))
            current, size = [], 0
        current.append(line)
        size += len(line)
    if current:
        windows.append("\n\n".join(current))
    return windows


def valid_turns(folder: pathlib.Path) -> set:
    return {json.loads(line)["i"] for line in (folder / "turns.jsonl").read_text().splitlines()
            if line.strip()}


def repair_anchors(body: str, valid: set) -> tuple[str, int]:
    """Drop [turn-N] citations the session does not have.

    The model occasionally shifts to 1-based numbering, so a two-turn session
    gets [turn-2] and [turn-3]. A fabricated citation is worse than none: it
    looks checkable and isn't. The claim survives, the anchor is removed, and
    the count is recorded so the summary can be treated as suspect.
    """
    repaired = 0

    def swap(match) -> str:
        nonlocal repaired
        if int(match.group(1)) in valid:
            return match.group(0)
        repaired += 1
        return ""

    return re.sub(r"\[turn-(\d+)\]", swap, body), repaired


def summarize_one(key: str, harness: str, session: str, folder: pathlib.Path,
                  digest: str, target: pathlib.Path, turns: int) -> dict:
    """Summarise one session and write it. Runs on a worker thread."""
    windows = transcript_windows(folder)
    tin = tout = 0
    if len(windows) == 1:
        body, a, b = chat(key, SUMMARY_PROMPT, f"Session:\n\n{windows[0]}")
        tin += a
        tout += b
    else:
        partials = []
        for number, window in enumerate(windows, 1):
            part, a, b = chat(key, SUMMARY_PROMPT,
                              f"Part {number} of {len(windows)} of one session:\n\n{window}")
            tin += a
            tout += b
            if part.upper().startswith(DECLINE):
                continue
            partials.append(f"### Part {number}\n{part}")
        if not partials:
            body = DECLINE
        else:
            body, a, b = chat(key, CONSOLIDATE_PROMPT, "\n\n".join(partials))
            tin += a
            tout += b

    body, repaired = repair_anchors(body, valid_turns(folder))
    cost = summary_cost(tin, tout)
    declined = body.upper().startswith(DECLINE)
    target.parent.mkdir(parents=True, exist_ok=True)
    write_atomic(target, (
        "---\n"
        f"harness: {harness}\n"
        f"session: {session}\n"
        f"turns: {turns}\n"
        f"model: {SUMMARY_MODEL}\n"
        f"source_digest: {digest}\n"
        "generated: true\n"
        f"declined: {'true' if declined else 'false'}\n"
        f"cost_usd: {cost:.6f}\n"
        f"tokens_in: {tin}\n"
        f"tokens_out: {tout}\n"
        f"windows: {len(windows)}\n"
        f"anchors_repaired: {repaired}\n"
        f"created: {dt.datetime.now().isoformat(timespec='seconds')}\n"
        "---\n\n"
        f"{body}\n"))
    print(f"  {harness:9} {session[:28]:28} turns={turns:5} "
          f"{'declined' if declined else 'summarized':10} ${cost:.4f}  "
          f"windows={len(windows)}", flush=True)
    return {"cost": cost, "declined": declined}


def cmd_summarize(args) -> int:
    key = deepinfra_key() if not args.dry_run else ""

    # Build the work list first, so the cheap filters (up-to-date, too short,
    # wrong harness) never occupy a worker slot.
    items = []
    skipped = 0
    for manifest_file in sorted(RAW_DIR.glob("sessions/*/*/*/*/session.json")):
        manifest = json.loads(manifest_file.read_text())
        harness = manifest.get("harness", "?")
        session = manifest.get("id", manifest_file.parent.name)
        if args.harness and harness != args.harness:
            continue
        if args.session and session != args.session:
            continue
        turns = manifest.get("turns", 0)
        if turns < 2:
            skipped += 1
            continue
        folder = manifest_file.parent
        turns_file = folder / "turns.jsonl"
        # A session still being written changes again in minutes, so summarizing
        # it now pays twice for the same content — and the nightly run makes that
        # a daily tax on the session you are in.
        if not args.force and (dt.datetime.now().timestamp() - turns_file.stat().st_mtime) < args.min_age_hours * 3600:
            skipped += 1
            continue
        digest = hashlib.sha256(turns_file.read_bytes()).hexdigest()
        target = summary_path(harness, session)
        if not args.force and stored_digest(target) == digest:
            skipped += 1
            continue
        items.append((harness, session, folder, digest, target, turns))
        if len(items) >= args.limit:
            break

    if args.dry_run:
        for harness, session, folder, _digest, _target, turns in items:
            windows = len(transcript_windows(folder))
            print(f"  {harness:9} {session[:28]:28} turns={turns:5} windows={windows}", flush=True)
        print(f"mem: would summarize {len(items)} session(s), {skipped} up to date")
        return 0

    # Concurrency because a backfill is otherwise hours: measured ~12 s per
    # session serially, ~1,045 sessions. The budget check is per batch, so a run
    # can overshoot by at most one batch.
    import concurrent.futures

    spent = 0.0
    done = declined = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        for start in range(0, len(items), args.jobs):
            if spent >= args.budget:
                print(f"mem: budget ${args.budget:.2f} reached after {done} summar"
                      f"{'y' if done == 1 else 'ies'}", flush=True)
                break
            batch = items[start:start + args.jobs]
            futures = [pool.submit(summarize_one, key, *item) for item in batch]
            for future in futures:
                try:
                    result = future.result()
                except SystemExit:
                    raise
                except Exception as exc:  # noqa: BLE001 - one bad session must not stop the run
                    print(f"mem: session failed: {exc}", flush=True)
                    continue
                spent += result["cost"]
                declined += 1 if result["declined"] else 0
                done += 1

    print(f"mem: summarized {done} session(s), {skipped} up to date, {declined} declined, "
          f"spent ${spent:.4f}", flush=True)
    return 0


# ------------------------------------------------------------- principles --
#
# Phase 5's first half, deliberately the cheap half: cluster the summaries by
# signals that already exist in the archive (the edges), then let a model
# articulate principles only inside those clusters. Clustering 1,045 summaries
# in one call gives mush; clustering by what the sessions actually touched is
# deterministic, reproducible, and hands each candidate its evidence set.
#
# Nothing here writes to a skill or AGENTS.md. Output is a proposal document for
# review — the plan's highest hard rule.

PRINCIPLES = MEMORY_DIR / "principles"
MAX_PRINCIPLES = 3

PRINCIPLE_PROMPT = """The summaries below come from separate sessions that share \
one signal (an error signature, a file, or a command). Several may describe the
same underlying lesson.

Propose at most 3 durable principles this evidence supports.

For each, output exactly:
### <short-kebab-id>
**Statement**: one or two sentences, imperative, addressed to a future agent.
**Applies when**: the conditions where this helps — task type, harness, path globs.
**Evidence**: one anchor per supporting claim, as
`session://<harness>/<session-id>#turn-N`, using only turn numbers that appear
in the summaries below.
**Suggested rung**: agents-md | skill | hook | automation — and one clause on why.

Rules:
- A principle with no supporting evidence is not a principle; drop it.
- Restate nothing the summaries do not support.
- If the signal is shared but teaches nothing durable, reply exactly NO PRINCIPLE."""

# Signals that cluster by *tooling* rather than by cause: every session runs git,
# and "traceback" names a thousand different bugs. A principle derived from them
# would be mush, so they are excluded rather than ranked low.
_GENERIC_SIGNALS = {
    "file:~", "file:~/.config", "file:~/.config/nix",
    "cmd:ls", "cmd:cat", "cmd:cd", "cmd:echo", "cmd:git", "cmd:rg", "cmd:grep",
    "cmd:sed", "cmd:awk", "cmd:find", "cmd:fd", "cmd:head", "cmd:tail", "cmd:wc",
    "error:webfetch failed", "error:traceback (most recent call last):",
}
_SIGNAL_RANK = {"error": 0, "file": 1, "cmd": 2}


def normalize_signal(kind: str, dst: str) -> str:
    dst = dst.strip()
    home = str(pathlib.Path.home())
    if dst.startswith(home):
        dst = "~" + dst[len(home):]
    if kind == "command":
        return "cmd:" + (dst.split() or [""])[0][:40]
    if kind == "file":
        return "file:" + dst[:120]
    return "error:" + re.sub(r"\s+", " ", dst.lower())[:120]


def load_summaries() -> list:
    out = []
    for path in sorted(SUMMARIES.rglob("*.md")):
        text = path.read_text()
        # The file opens with "---", so partition on the opening delimiter alone
        # would return an empty meta and swallow the real body.
        rest = text[3:] if text.startswith("---") else text
        meta, _, body = rest.partition("---")
        fields = {}
        for line in meta.splitlines():
            if ":" in line:
                key, _, value = line.partition(":")
                fields[key.strip()] = value.strip()
        if fields.get("declined") == "true":
            continue
        session = fields.get("session")
        if not session:
            continue
        out.append({
            "harness": fields.get("harness", path.parent.name),
            "session": session,
            "turns": fields.get("turns", "0"),
            "body": body.strip(),
        })
    return out


def session_signals(harness: str, session: str) -> set:
    found = list((RAW_DIR / "sessions").glob(f"{harness}/*/*/{session}/edges.jsonl"))
    if not found:
        return set()
    signals = set()
    for line in found[0].read_text().splitlines():
        if not line.strip():
            continue
        edge = json.loads(line)
        signals.add(normalize_signal(edge["kind"], edge["dst"]))
    return signals


def build_clusters(min_sessions: int = 2) -> list:
    summaries = load_summaries()
    by_signal: dict = {}
    for summary in summaries:
        for signal in session_signals(summary["harness"], summary["session"]):
            by_signal.setdefault(signal, []).append(summary)

    clusters = [(signal, members) for signal, members in by_signal.items()
                if len(members) >= min_sessions and signal not in _GENERIC_SIGNALS]
    # Specific failures first: an error signature shared by several sessions is
    # the strongest evidence of a repeated lesson; a file or a command shared by
    # several is usually just "this is the project I was working in".
    clusters.sort(key=lambda c: (_SIGNAL_RANK.get(c[0].split(":", 1)[0], 9),
                                 -len(c[1])))

    # Drop clusters that are subsets of a larger one: the same sessions would be
    # sent to the model twice and produce duplicate principles.
    kept = []
    for signal, members in clusters:
        if any(set(m["session"] for m in members) <= set(m["session"] for m in other)
               for _, other in kept):
            continue
        kept.append((signal, members))
    return kept


_STOPWORDS = {
    "the", "and", "that", "with", "from", "this", "will", "when", "then", "than",
    "into", "must", "should", "never", "always", "before", "after", "which",
    "there", "their", "them", "they", "have", "been", "being", "does", "does",
    "your", "yours", "only", "also", "just", "like", "make", "makes", "made",
    "such", "some", "each", "over", "under", "more", "most", "very", "what",
    "where", "while", "without", "within", "would", "could", "about", "because",
}


def curated_corpus() -> list:
    """The documents a proposal should be checked against before review."""
    roots = [HOME / "AGENTS.md", HOME / "DECISIONS.md"]
    roots += sorted((HOME / ".config" / "nix" / "agent-skills").glob("*/SKILL.md"))
    roots += sorted((HOME / "docs" / "learnings").glob("*.md"))
    corpus = []
    for path in roots:
        if not path.exists() or path.name == "README.md":
            continue
        try:
            corpus.append((str(path).replace(str(HOME), "~"), path.read_text().lower()))
        except OSError:
            continue
    return corpus


def key_terms(text: str, limit: int = 10) -> list:
    words = re.findall(r"[a-z][a-z0-9_-]{3,}", text.lower())
    seen, terms = set(), []
    for word in sorted(words, key=len, reverse=True):
        if word in _STOPWORDS or word in seen:
            continue
        seen.add(word)
        terms.append(word)
        if len(terms) >= limit:
            break
    return terms


def documentation_hit(statement: str, corpus: list) -> tuple:
    """Best matching curated doc and how many of the statement's key terms it holds."""
    terms = key_terms(statement)
    if not terms:
        return (None, 0, 0)
    best, best_hits = None, 0
    for path, text in corpus:
        hits = sum(1 for term in terms if term in text)
        if hits > best_hits:
            best, best_hits = path, hits
    return (best, best_hits, len(terms))


def audit_proposals(path: pathlib.Path) -> int:
    blocks = re.split(r"(?m)^### ", path.read_text())[1:]
    corpus = curated_corpus()
    statements = []
    print(f"{len(blocks)} proposal(s) checked against {len(corpus)} curated document(s)\n")
    rows = []
    for block in blocks:
        ident = block.splitlines()[0].strip()
        match = re.search(r"\*\*Statement\*\*:\s*(.+)", block)
        statement = match.group(1).strip() if match else ""
        statements.append((ident, statement))
        where, hits, total = documentation_hit(statement, corpus)
        share = hits / total if total else 0
        verdict = "documented" if (hits >= 3 and share >= 0.5) else "new"
        rows.append((verdict, ident, hits, total, where))
    for verdict, ident, hits, total, where in sorted(rows):
        mark = "DOC " if verdict == "documented" else "NEW "
        print(f"  {mark} {ident[:52]:52} {hits}/{total} terms  {where or ''}")

    # The same lesson proposed twice is also a duplicate, even when neither copy
    # is documented yet.
    print()
    duplicate_pairs = 0
    for i in range(len(statements)):
        for j in range(i + 1, len(statements)):
            a, b = set(key_terms(statements[i][1])), set(key_terms(statements[j][1]))
            if not a or not b:
                continue
            shared = len(a & b) / min(len(a), len(b))
            if shared >= 0.5:
                duplicate_pairs += 1
                print(f"  DUP {statements[i][0][:40]:40} ~ {statements[j][0][:40]:40} ({shared:.0%})")
    new = sum(1 for r in rows if r[0] == "new")
    print(f"\nmem: {new} new, {len(rows) - new} already documented, {duplicate_pairs} overlapping pair(s)")
    return 0


def cmd_principles(args) -> int:
    if args.audit:
        if args.audit == "latest":
            found = sorted(PRINCIPLES.glob("proposed-*.md"))
            if not found:
                die("no proposal file to audit; run `mem principles` first", 1)
            return audit_proposals(found[-1])
        return audit_proposals(pathlib.Path(args.audit))

    clusters = build_clusters(args.min_sessions)
    if not clusters:
        print("mem: no clusters — run `mem summarize` first")
        return 0
    clusters = clusters[: args.max_clusters]

    print(f"mem: {len(clusters)} cluster(s) from {len(load_summaries())} summaries")
    for signal, members in clusters:
        print(f"  {len(members):3} sessions  {signal[:100]}")

    if args.cluster_only or args.dry_run:
        return 0

    key = deepinfra_key()
    spent = 0.0
    proposals = []
    for signal, members in clusters:
        if spent >= args.budget:
            print(f"mem: budget ${args.budget:.2f} reached")
            break
        evidence = []
        for m in members[:8]:
            body = m["body"][:3000]
            evidence.append(f"--- session://{m['harness']}/{m['session']} ({m['turns']} turns)\n{body}")
        user = f"Shared signal: {signal}\n\n" + "\n\n".join(evidence)
        text, tin, tout = chat(key, PRINCIPLE_PROMPT, user)
        spent += summary_cost(tin, tout)
        if text.upper().startswith("NO PRINCIPLE"):
            print(f"  declined        {signal[:70]}")
            continue
        proposals.append(f"## Signal: {signal}\n\nSessions: {len(members)}, "
                         f"e.g. `session://{members[0]['harness']}/{members[0]['session']}`\n\n{text}\n")
        print(f"  proposed        {signal[:70]}")

    if not proposals:
        print(f"mem: no principles proposed, ${spent:.4f}")
        return 0

    target = PRINCIPLES / f"proposed-{today()}.md"
    write_atomic(target, (
        "---\n"
        "kind: principle-proposals\n"
        "generated: true\n"
        f"model: {SUMMARY_MODEL}\n"
        f"cost_usd: {spent:.4f}\n"
        f"created: {dt.datetime.now().isoformat(timespec='seconds')}\n"
        "---\n\n"
        "# Proposed principles\n\n"
        "Generated from the archive. Nothing here is in effect: promoting one means\n"
        "editing the skill it names, as a diff, for review.\n\n"
        + "\n".join(proposals)))
    print(f"mem: wrote {target} ({len(proposals)} cluster(s), ${spent:.4f})")
    return 0


# ------------------------------------------------------------------ doctor --
#
# Report only. Nothing here edits a skill or AGENTS.md — the same hard rule as
# the principle proposals. Exit code is non-zero when any check fails, so it can
# gate a commit.
#
# Slice 1 covers the three checks that already found something by hand: the
# always-loaded budget (4,827 tokens against a 4,000 target), the skills layer (a
# 1.1 MB opencode-only duplicate and an unroutable skill with no description),
# and whether a skill's referenced paths still exist (the unroutable one was a
# stale copy of a document that had moved on).

_WIRED_SKILL_DIRS = (
    ".agents/skills",
    ".claude/skills",
    ".config/opencode/skills",
    ".hermes/skills/dotfiles",
)

# Deliberately a fixed list rather than every backticked token: `nr` and `config`
# are fish functions, so `which` alone reports false failures, and probing every
# word-shaped token would drown the report in `true`, `null` and `int`.
_DOCTOR_COMMANDS = ("nr", "nh", "mem", "alejandra", "gh", "nix", "git", "rg", "fd", "hx", "ssh")

DOCTOR_AGENTS = pathlib.Path(os.environ.get("MEM_DOCTOR_AGENTS") or HOME / "AGENTS.md")
DOCTOR_SKILLS = pathlib.Path(os.environ.get("MEM_DOCTOR_SKILLS") or HOME / ".config" / "nix" / "agent-skills")
_DOCTOR_WIRED_ENV = os.environ.get("MEM_DOCTOR_WIRED")


def _tokens(text: str) -> int:
    return len(text) // 4


def _skills(root: pathlib.Path) -> dict:
    out = {}
    for skill in sorted(root.glob("*/SKILL.md")):
        body = skill.read_text()
        found = re.search(r"(?m)^description:\s*(.*)$", body)
        out[skill.parent.name] = (found.group(1).strip() if found else "", body)
    return out


def _resolvable(command: str) -> bool:
    import shutil

    if shutil.which(command):
        return True
    try:  # fish functions like `nr` are not binaries
        return subprocess.run(["fish", "-c", f"type -q {command}"],
                              capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def cmd_doctor(args) -> int:
    findings = []  # (level, section, text)

    # --- budget ---------------------------------------------------------
    agents_tokens = _tokens(DOCTOR_AGENTS.read_text()) if DOCTOR_AGENTS.exists() else 0
    skills = _skills(DOCTOR_SKILLS)
    desc_tokens = sum(len(d) for d, _ in skills.values()) // 4
    total = agents_tokens + desc_tokens
    findings.append(("info", "budget", f"AGENTS.md            {agents_tokens:5} tokens"))
    findings.append(("info", "budget", f"skill descriptions   {desc_tokens:5} tokens ({len(skills)} skills)"))
    level = "fail" if total > args.budget else ("warn" if total > args.budget * 0.95 else "ok")
    findings.append((level, "budget", f"always-loaded total  {total:5} / {args.budget} tokens"))

    for label, path in ((".config/nix/AGENTS.md", HOME / ".config" / "nix" / "AGENTS.md"),
                        ("docs/plans/", HOME / "docs" / "plans"),
                        ("DECISIONS.md", HOME / "DECISIONS.md")):
        if not path.exists():
            continue
        size = path.read_text() if path.is_file() else "".join(
            f.read_text() for f in path.glob("*.md"))
        findings.append(("info", "conditional",
                         f"{label:22} {_tokens(size):5} tokens (loads only in context)"))

    # --- skill inventory ------------------------------------------------
    canonical = set(skills)
    for name, (desc, _body) in skills.items():
        if not desc:
            findings.append(("fail", "skills", f"{name}: no description — nothing can route to it"))

    wired = (_DOCTOR_WIRED_ENV.split(":") if _DOCTOR_WIRED_ENV
             else [str(HOME / d) for d in _WIRED_SKILL_DIRS])
    for directory in wired:
        path = pathlib.Path(directory)
        if not path.is_dir():
            findings.append(("fail", "skills", f"{str(path).replace(str(HOME), '~')}: missing"))
            continue
        entries = {p.name for p in path.iterdir() if p.is_dir() and not p.name.startswith(".")}
        extras = sorted(entries - canonical)
        missing = sorted(canonical - entries)
        for extra in extras:
            findings.append(("fail", "skills",
                             f"{str(path).replace(str(HOME), '~')}: {extra} is not in the shared store"))
        for gone in missing:
            findings.append(("fail", "skills",
                             f"{str(path).replace(str(HOME), '~')}: {gone} missing"))
        for entry in sorted(entries & canonical):
            if not (path / entry).is_symlink():
                findings.append(("warn", "skills",
                                 f"{str(path).replace(str(HOME), '~')}/{entry} is a real directory, not a nix link"))
        if not extras and not missing:
            findings.append(("ok", "skills", f"{str(path).replace(str(HOME), '~')}: {len(entries)} skills, in step"))

    # --- skill truth ----------------------------------------------------
    # A skill that documents where something *used to* live is correct, not stale:
    # "moved here from ~/.gitconfig, which is gone" would otherwise be reported
    # twice. Likewise macOS app-support paths, which are noisy and rarely ours.
    absent = re.compile(
        r"(?i)\b(gone|moved from|no longer|instead|removed|not link|historic|deprecated|absent"
        r"|do not|don't|never|must not)\b")
    # A path that lives on another machine is not missing here, and a file the
    # caller supplies (`--body-file ~/body.md`) is not a broken reference.
    elsewhere = re.compile(r"(?i)\b(sophrosyne|metanoia|remote host|home\.ggr\.com)\b")
    supplied = re.compile(r"--(body|notes)-file|-F\b")
    for name, (_desc, body) in skills.items():
        for line in body.splitlines():
            # Strip emphasis before matching: "do **not** also link" is a
            # negation, but markdown bold puts asterisks inside the phrase.
            flat = line.replace("**", "").replace("__", "")
            if absent.search(flat) or elsewhere.search(flat) or supplied.search(flat):
                continue
            for match in re.finditer(r"(?:~/|/Users/scott/)[A-Za-z0-9._/@+-]+", line):
                raw = match.group(0).rstrip(".,;:)")
                if any(ch in raw for ch in "<>*$") or raw.startswith(("~/Library", "/Users/scott/Library")):
                    continue
                target = pathlib.Path(raw.replace("~", str(HOME), 1))
                if not target.exists():
                    findings.append(("warn", "truth", f"{name}: references missing {raw}"))
    mentioned = {cmd for cmd in _DOCTOR_COMMANDS
                 if any(re.search(rf"`{cmd}[ `]", body) for _, body in skills.values())}
    for command in sorted(mentioned):
        if not _resolvable(command):
            findings.append(("warn", "truth", f"`{command}` is referenced by a skill but not resolvable"))

    # --- freshness ------------------------------------------------------
    # The archive is only as true as its last ingest, and every claim built on it
    # — recall finding things, principles being current, the MCP server answering
    # for Osaurus — quietly degrades as it ages. Nothing else in doctor looks at
    # time, so this is the check that would have caught yesterday's data being
    # served today.
    now = dt.datetime.now()
    for harness in ("pi", "opencode", "hermes", "osaurus"):
        state_file = RAW_DIR / "state" / f"{harness}.json"
        if not state_file.exists():
            findings.append(("warn", "freshness", f"{harness}: never ingested"))
            continue
        try:
            stamped = str(json.loads(state_file.read_text()).get("updated") or "")
            when = dt.datetime.fromisoformat(stamped)
        except ValueError:
            findings.append(("warn", "freshness", f"{harness}: unreadable ingest state"))
            continue
        sessions = list((RAW_DIR / "sessions" / harness).glob("*/*/*/session.json"))
        age = now - when
        level = "warn" if age > dt.timedelta(days=3) else "ok"
        findings.append((level, "freshness",
                         f"{harness}: last ingest {stamped[:16]} ({age.days}d), "
                         f"{len(sessions)} sessions"))

    missing = drifted = 0
    for manifest_file in RAW_DIR.glob("sessions/*/*/*/*/session.json"):
        try:
            manifest = json.loads(manifest_file.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if manifest.get("turns", 0) < 2:
            continue  # the summarizer skips these by design
        harness = manifest.get("harness") or manifest_file.parts[-5]
        session = manifest.get("id") or manifest_file.parent.name
        target = SUMMARIES / harness / f"{session}.md"
        if not target.exists():
            missing += 1
            continue
        current = hashlib.sha256(
            (manifest_file.parent / "turns.jsonl").read_bytes()).hexdigest()
        recorded = stored_digest(target)
        if recorded and recorded != current:
            drifted += 1
    if missing:
        findings.append(("info", "freshness", f"{missing} session(s) not summarized yet"))
    findings.append(("warn" if drifted else "ok", "freshness",
                     f"{drifted} summary(ies) behind their session" if drifted
                     else "summaries match their sessions"))

    learn_root = HOME / "docs" / "learnings"
    index_file = learn_root / "README.md"
    if index_file.exists():
        listed = set(re.findall(r"\((\d{4}-\d{2}-\d{2}-[a-z0-9-]+\.md)\)",
                                index_file.read_text()))
        files = {f.name for f in learn_root.glob("*.md") if f.name != "README.md"}
        dangling = sorted(listed - files)
        unlisted = sorted(files - listed)
        for name in dangling:
            findings.append(("fail", "freshness", f"docs/learnings index points at missing {name}"))
        if unlisted:
            findings.append(("warn", "freshness",
                             f"{len(unlisted)} learnings missing from the index, e.g. {unlisted[0]}"))
        if not dangling and not unlisted:
            findings.append(("ok", "freshness",
                             f"docs/learnings: {len(files)} entries, index in step"))

    # A scheduled job that died looks exactly like one with nothing to do, so the
    # age of the newest report is the only evidence the loop is still running.
    if REPORTS.is_dir():
        reports = sorted(REPORTS.glob("*.md"))
        if reports:
            try:
                age = (dt.date.today() - dt.date.fromisoformat(reports[-1].stem)).days
            except ValueError:
                age = None
            if age is None:
                findings.append(("warn", "freshness", f"unreadable report name {reports[-1].name}"))
            else:
                findings.append(("warn" if age > 2 else "ok", "freshness",
                                 f"last nightly report {reports[-1].stem} ({age}d old)"))
        else:
            findings.append(("warn", "freshness", "nightly reports directory is empty"))

    # --- report ---------------------------------------------------------
    if args.json:
        print(json.dumps({
            "budget": {"agents": agents_tokens, "skills": desc_tokens,
                       "total": total, "target": args.budget},
            "skills": sorted(canonical),
            "findings": [{"level": lvl, "section": sec, "text": txt} for lvl, sec, txt in findings],
            "ok": not any(lvl == "fail" for lvl, _, _ in findings),
        }, indent=2))
    else:
        section = None
        for level, sec, text in findings:
            if sec != section:
                print(f"\n{sec}")
                section = sec
            print(f"  {level:4}  {text}")
        fails = sum(1 for level, _, _ in findings if level == "fail")
        warns = sum(1 for level, _, _ in findings if level == "warn")
        print(f"\nmem: {fails} failing, {warns} warning(s)")

    return 1 if any(level == "fail" for level, _, _ in findings) else 0


# ----------------------------------------------------------------- nightly --
#
# The maintenance loop, so staleness is self-correcting rather than remembered.
# Every step is a subprocess of this same script: it isolates a failure to one
# stage instead of aborting the run, and it keeps `die()`'s SystemExit out of a
# pipeline that must always finish by writing a report.
#
# What it may write: the archive and the curated store. Never AGENTS.md, a skill
# or a hook — that rule does not change because the caller is a scheduler.

REPORTS = MEMORY_DIR / "reports"
NIGHTLY_HARNESSES = ("pi", "opencode", "hermes", "osaurus")


def _step(args: list) -> tuple:
    """Run one stage of this script. Returns (rc, combined output)."""
    try:
        proc = subprocess.run(
            [sys.executable, str(pathlib.Path(__file__).resolve()), *args],
            capture_output=True, text=True, timeout=1800)
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, f"could not run {' '.join(args)}: {exc}"
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def cmd_nightly(args) -> int:
    stages = []
    failed = False

    if not args.no_ingest:
        for harness in NIGHTLY_HARNESSES:
            rc, out = _step(["ingest", harness])
            failed = failed or rc != 0
            stages.append((f"ingest {harness}", rc, out.strip()))

    if not args.no_summarize:
        rc, out = _step(["summarize", "--budget", str(args.budget), "--jobs", "8"])
        failed = failed or rc != 0
        stages.append((f"summarize (budget ${args.budget:.2f})", rc, out.strip()))

    rc, out = _step(["doctor"])
    # doctor exits 1 for a failing check, which is a finding, not a crash: the
    # report carries it and the run still completes.
    stages.append(("doctor", rc, out.strip()))

    stamps = dt.datetime.now().isoformat(timespec="seconds")
    header = f"# Nightly — {stamps[:10]}\n\nrun at {stamps}\n"
    body = []
    for name, rc, out in stages:
        mark = "ok" if rc == 0 else f"exit {rc}"
        body.append(f"## {name} — {mark}\n\n```\n{out or '(no output)'}\n```\n")

    report = header + "\n" + "\n".join(body)
    if args.dry_run:
        print(report)
        return 0

    REPORTS.mkdir(parents=True, exist_ok=True)
    target = REPORTS / f"{stamps[:10]}.md"
    write_atomic(target, report)
    print(f"mem: nightly report {target}")
    for name, rc, out in stages:
        first = (out.splitlines() or [""])[0][:100]
        print(f"  {name:28} {'ok' if rc == 0 else f'exit {rc}'}  {first}")
    return 1 if failed else 0


# --------------------------------------------------------------------- main --


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="mem", add_help=True, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    learn = sub.add_parser("learn", help="write a docs/learnings entry and index it")
    learn.add_argument("slug", nargs="?")
    learn.add_argument("--repo", help="repo root (default: git toplevel of cwd)")
    learn.add_argument("--title", required=True)
    learn.add_argument("--symptom", required=True)
    learn.add_argument("--cause", required=True)
    learn.add_argument("--fix", required=True)
    learn.add_argument("--see", action="append", help="see-also reference (repeatable)")
    learn.add_argument("--force", action="store_true")
    learn.set_defaults(fn=cmd_learn)

    inbox = sub.add_parser("inbox", help="the shared inbox")
    inbox_sub = inbox.add_subparsers(dest="inbox_cmd", required=True)
    add = inbox_sub.add_parser("add", help="append a candidate line")
    add.add_argument("kind", help="bash, correction, learning, note, …")
    add.add_argument("text", nargs="+")
    add.add_argument("--session")
    add.set_defaults(fn=cmd_inbox_add)
    show = inbox_sub.add_parser("show", help="print the inbox")
    show.set_defaults(fn=cmd_inbox_show)

    distill = sub.add_parser("distill", help="print the inbox and the promotion ladder")
    distill.set_defaults(fn=cmd_distill)

    recall = sub.add_parser("recall", help="search past sessions of every harness")
    recall.add_argument("query")
    recall.add_argument("--days", type=int, default=30)
    recall.add_argument("--limit", type=int, default=6)
    recall.add_argument("--source", default="all",
                        choices=["all", "archive", "docs", "pi", "opencode", "hermes"])
    recall.add_argument("--json", action="store_true", help="emit records instead of text")
    recall.add_argument("--include-archive", action="store_true",
                        help="also search docs/archive (abandoned approaches)")
    recall.set_defaults(fn=cmd_recall)

    ing = sub.add_parser("ingest", help="copy a harness's sessions into the archive")
    ing.add_argument("harness", nargs="?", default="pi", choices=["pi", "opencode", "hermes", "osaurus"])
    ing.add_argument("--dry-run", action="store_true", help="parse and report, write nothing")
    ing.set_defaults(fn=cmd_ingest)

    night = sub.add_parser("nightly", help="ingest, summarize and report (for launchd)")
    night.add_argument("--budget", type=float, default=0.25,
                       help="spend cap for summarizing (USD, default 0.25)")
    night.add_argument("--no-ingest", action="store_true")
    night.add_argument("--no-summarize", action="store_true")
    night.add_argument("--dry-run", action="store_true", help="print the report, write nothing")
    night.set_defaults(fn=cmd_nightly)

    doc = sub.add_parser("doctor", help="audit the budget, skills and skill references")
    doc.add_argument("--budget", type=int, default=4000, help="always-loaded token target")
    doc.add_argument("--json", action="store_true")
    doc.set_defaults(fn=cmd_doctor)

    mcp_p = sub.add_parser("mcp", help="serve memory over MCP on stdio (for Osaurus)")
    mcp_p.set_defaults(fn=cmd_mcp)

    prin = sub.add_parser("principles", help="cluster summaries into principle proposals")
    prin.add_argument("--min-sessions", type=int, default=2)
    prin.add_argument("--max-clusters", type=int, default=12)
    prin.add_argument("--budget", type=float, default=0.50)
    prin.add_argument("--cluster-only", action="store_true", help="cluster, no model call")
    prin.add_argument("--audit", nargs="?", const="latest", help="dedupe an existing proposal file")
    prin.add_argument("--dry-run", action="store_true")
    prin.set_defaults(fn=cmd_principles)

    summ = sub.add_parser("summarize", help="summarize archived sessions (network)")
    summ.add_argument("--harness", choices=["pi", "opencode", "hermes", "osaurus"])
    summ.add_argument("--session", help="only this session id (for targeted re-runs)")
    summ.add_argument("--min-age-hours", type=float, default=2.0,
                      help="skip sessions modified more recently than this (default 2)")
    summ.add_argument("--limit", type=int, default=50)
    summ.add_argument("--budget", type=float, default=1.0)
    summ.add_argument("--force", action="store_true", help="redo existing summaries")
    summ.add_argument("--jobs", type=int, default=4, help="concurrent requests (default 4)")
    summ.add_argument("--dry-run", action="store_true", help="list what would be done")
    summ.set_defaults(fn=cmd_summarize)

    show = sub.add_parser("show", help="print a turn from the archive by anchor")
    show.add_argument("anchor", help="session://<harness>/<session-id>[#turn-N]")
    show.set_defaults(fn=lambda a: show_anchor(a.anchor))

    dec = sub.add_parser("decisions", help="print ~/DECISIONS.md")
    dec.set_defaults(fn=cmd_decisions)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
