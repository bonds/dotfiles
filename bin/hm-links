#!/usr/bin/env bash
# hm-links — audit and repair the symlinks home-manager places in $HOME.
#
# home-manager links every managed path to <generation>/home-files/<path> and
# re-links all of them on each activation. Two things still go wrong:
#
#   1. Directory-symlink orphan. When a managed path changes from one
#      whole-directory symlink to per-file links, HM's cleanOldGen removes
#      leaves but not the directory symlink itself. That path keeps resolving
#      into an OLD generation, and dangles once the generation is collected.
#      Observed 2026-10-18: ~/.pi/agent/skills stayed a symlink after the
#      switch to per-skill links, so pi saw every skill twice and printed
#      "[Skill conflicts]".
#   2. Dangling link after pruning. A link into a pruned-and-collected
#      generation points at nothing.
#
# Both are fixed by repointing the link at the current generation: content is
# identical, only the store path changes. Nothing is ever deleted except a
# stale directory symlink, which is replaced by a real directory.
#
# Usage:
#   hm-links [--fix] [--scan] [--quiet] [--generation PATH]
#     --fix          repair instead of only reporting
#     --scan         also scan $HOME for home-manager-files links the current
#                    generation does not manage (slow; reports orphans only)
#     --quiet        print only the summary and any problems that remain
#     --generation   use this generation instead of the current-home gcroot
#                    (home-manager's activation passes its own $newGenPath:
#                    the gcroot is only re-pointed at the END of activation,
#                    so reading it mid-activation yields the PREVIOUS
#                    generation and every "repair" would undo linkNewGen)
#
# Exit: 0 clean (or fully repaired), 1 problems remain, 2 cannot locate the
# current home-manager generation.
#
# Note for future edits: BSD find's -lname does not let '*' cross '/', so
# -lname '*/home-manager-files/*' matches nothing; use '*home-manager-files*'.

set -u

fix=0
scan=0
quiet=0
gen_arg=""
while [ $# -gt 0 ]; do
	case "$1" in
	--fix) fix=1 ;;
	--scan) scan=1 ;;
	--quiet) quiet=1 ;;
	--generation)
		if [ $# -lt 2 ]; then
			echo "hm-links: --generation needs a path" >&2
			exit 2
		fi
		gen_arg="$2"
		shift
		;;
	-h | --help)
		sed -n '2,40p' "$0"
		exit 0
		;;
	*)
		echo "hm-links: unknown option: $1" >&2
		exit 2
		;;
	esac
	shift
done

if [ -n "$gen_arg" ]; then
	gen=$(cd "$gen_arg" && pwd -P)
else
	root="$HOME/.local/state/home-manager/gcroots/current-home"
	if [ ! -e "$root" ]; then
		echo "hm-links: no current home-manager generation at $root" >&2
		exit 2
	fi
	gen=$(cd "$root" && pwd -P)
fi
# `home-files` is itself a symlink to <hash>-home-manager-files, so resolve it
# too: the managed links point at the resolved store path, not at the
# generation directory.
hf=$(cd "$gen/home-files" 2>/dev/null && pwd -P)
if [ -z "${hf:-}" ] || [ ! -d "$hf" ]; then
	echo "hm-links: $gen/home-files is missing" >&2
	exit 2
fi

say() { [ "$quiet" = 1 ] || echo "$@"; }

managed=$(cd "$hf" && find . \( -type f -o -type l \) -print | sed 's|^\./||')
if [ -z "$managed" ]; then
	echo "hm-links: no managed files in $hf" >&2
	exit 2
fi

problems=0
fixed=0

# Pass 1 — a directory on the way to a managed file must be a real directory.
# This is the orphan class: unlink the stale symlink and let pass 2 recreate
# the per-file links inside it.
seen=""
while IFS= read -r rel; do
	[ -n "$rel" ] || continue
	dir="$rel"
	while :; do
		dir=$(dirname "$dir")
		[ "$dir" = "." ] && break
		case " $seen " in
		*" $dir "*) break ;; # ancestors handled with an earlier file
		esac
		seen="$seen $dir"
		t="$HOME/$dir"
		[ -L "$t" ] || continue
		if [ "$fix" = 1 ]; then
			rm -f "$t" && mkdir -p "$t" || {
				echo "hm-links: could not replace $t" >&2
				problems=$((problems + 1))
				continue
			}
			fixed=$((fixed + 1))
			say "unlinked directory symlink: $t"
		else
			problems=$((problems + 1))
			echo "DIR-SYMLINK $t -> $(readlink "$t")"
		fi
	done
done <<<"$managed"

# Pass 2 — every managed path must be a link into the current generation.
while IFS= read -r rel; do
	[ -n "$rel" ] || continue
	t="$HOME/$rel"
	want="$hf/$rel"
	if [ -L "$t" ]; then
		cur=$(readlink "$t")
		if [ "$cur" != "$want" ]; then
			if [ "$fix" = 1 ]; then
				ln -sfn "$want" "$t" || {
					echo "hm-links: could not relink $t" >&2
					problems=$((problems + 1))
					continue
				}
				fixed=$((fixed + 1))
				say "relinked: $t"
			else
				problems=$((problems + 1))
				echo "STALE $t -> $cur"
			fi
		fi
	elif [ ! -e "$t" ]; then
		if [ "$fix" = 1 ]; then
			mkdir -p "$(dirname "$t")"
			ln -sfn "$want" "$t" || {
				echo "hm-links: could not link $t" >&2
				problems=$((problems + 1))
				continue
			}
			fixed=$((fixed + 1))
			say "linked: $t"
		else
			problems=$((problems + 1))
			echo "MISSING $t"
		fi
	elif ! cmp -s "$want" "$t"; then
		# A real file where HM wants a link is fine only if identical.
		problems=$((problems + 1))
		echo "CONFLICT $t (real file, differs from $want)"
	fi
done <<<"$managed"

# Pass 3 — optional: links into some home-manager-files generation that the
# current one does not manage at all. Report only; removing them is a
# judgement call (they are leftovers from configs that no longer exist).
if [ "$scan" = 1 ]; then
	managed_sp=" $(echo "$managed" | tr '\n' ' ') "
	while IFS= read -r l; do
		rel=${l#"$HOME"/}
		case "$managed_sp" in
		*" $rel "*) continue ;;
		esac
		problems=$((problems + 1))
		echo "ORPHAN $l -> $(readlink "$l")"
	done < <(find "$HOME" -type l -lname '*home-manager-files*' \
		-not -path "$HOME/Library/*" \
		-not -path "$HOME/.cache/*" \
		-not -path "$HOME/.Trash/*" \
		-not -path "$HOME/.local/share/dotfiles/*" \
		-not -path "$HOME/.local/state/*" \
		-not -path '*/node_modules/*' 2>/dev/null)
fi

if [ "$fix" = 1 ]; then
	echo "hm-links: fixed $fixed, remaining $problems"
else
	echo "hm-links: $problems problem(s)"
fi
[ "$problems" -eq 0 ] || exit 1
exit 0
