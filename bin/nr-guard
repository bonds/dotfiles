#!/usr/bin/env bash
# nr-guard -- keep `nr`'s two dotfiles checkouts in a state it can safely build.
#
# `nr` builds $HOME, which is also the apply checkout of the bare dotfiles repo.
# Two things have to be true before it builds:
#
#   $HOME        up to date with main. If it is merely BEHIND, apply main to it.
#                If it holds content that appears nowhere in main's history,
#                refuse to touch it -- that is local work (a hand-edit to look
#                at, or an `nr --update` retry's uncommitted bumps, which must
#                survive) -- and build what is there.
#   worktree/    the edit checkout. It rots silently: the pre-2026-10-19 `live/`
#                worktree reached 69 staged files behind main. Say so when it
#                differs from main, and distinguish real edits from a tree that
#                is only STALE -- what `nr --update` leaves behind when it
#                commits in $HOME, where committing would revert that commit.
#
# Split out of the `nr` fish function so this git logic can be tested against
# throwaway repos: see bin/tests/nr-guard-test.sh.
#
# Exit status: 0 = the caller may build; 1 = main could not be applied to $HOME
# and the caller must stop.
#
# NR_GUARD_ROOT (default $HOME) is the apply work tree, and the only thing the
# test suite overrides.
set -u

root=${NR_GUARD_ROOT:-$HOME}
root=${root%/}
# git refuses a relative work tree, and an unset HOME would make every call
# below resolve paths against the cwd.
case $root in
/*) ;;
*) root=$PWD/$root ;;
esac

# ---- git dir ------------------------------------------------------------
# Resolved by existence rather than hardcoded, so the same file is correct on
# every machine and mid-move: accismus nests the git dir at .../dotfiles/bare
# (since 2026-10-31), sophrosyne and older layouts keep the flat repo.
git_dir=$root/.local/share/dotfiles
if [ -d "$git_dir/bare" ]; then
	git_dir=$git_dir/bare
elif [ ! -d "$git_dir" ]; then
	git_dir=$root/.config/dotfiles
fi
[ -d "$git_dir" ] || {
	printf 'nr: WARNING no dotfiles repo at %s -- skipping the checkout guards\n' "$git_dir" >&2
	exit 0
}

edit_tree=$root/.local/share/dotfiles/worktree

g() { git -C "$root" --git-dir="$git_dir" --work-tree="$root" "$@"; }
e() { git -C "$edit_tree" "$@"; }

# Everything below is advice: this script exits 0 unless git itself failed, so a
# message must not read like a stop sign. `note:` marks the things nr does not
# act on — the edit tree is never built from — and `say` remembers that anything
# was said at all, so the run ends with a verdict. On 2026-11-20 a `nr --update`
# was cancelled at the first warning line, on a run that would have worked.
announced=no
say() {
	printf "$@" >&2
	announced=yes
}

# Positions of main whose content can explain what the work trees hold: the
# reflog, plus -- when the edit checkout has a branch of its own -- that branch.
# The branch matters because it does not move when main does: it is the ref an
# edit checkout's HEAD still stands at after a $HOME-side commit, long after the
# reflog entry for that commit has been pushed out.
positions() {
	g reflog show --format=%H main 2>/dev/null | head -25
	if [ -d "$edit_tree" ]; then
		b=$(e symbolic-ref --short HEAD 2>/dev/null) || b=
		case $b in
		'' | main | master) ;;
		*) g for-each-ref --format='%(objectname)' "refs/heads/$b" 2>/dev/null ;;
		esac
	fi
}

# Does <rev> track <path>? A path missing from history was simply not tracked
# then, so a position older than the file's introduction must not count as a
# match -- otherwise adding a tracked file would make every earlier position look
# like it explains whatever the working tree holds.
tracks() { g cat-file -e "$1:$2" 2>/dev/null; }

# Echo a position whose version of every given path matches the apply tree.
# No paths: the first position matches trivially, which is what "there is
# nothing of yours to lose" means.
# Fails when no position exists -- the work tree holds content of its own.
find_position() {
	for c in $(positions); do
		matched=yes
		for p in "$@"; do
			if ! tracks "$c" "$p" || ! g diff --quiet "$c" -- "$p" 2>/dev/null; then
				matched=no
				break
			fi
		done
		if [ "$matched" = yes ]; then
			echo "$c"
			return 0
		fi
	done
	return 1
}

# The edit worktree can share main's ref instead of having a branch of its own
# (the layout since the edit checkout was added). A $HOME-side commit then moves
# HEAD without touching the worktree, so its INDEX still describes the earlier
# main and git reports the bump as staged reverts. Match every staged blob
# against an older position: if they all match, the index is that older tree and
# there is nothing of the user's to lose.
index_at() { e rev-parse --verify --quiet ":$1" 2>/dev/null; }

index_matches_position() {
	for c in $(positions); do
		[ "$c" != "${main:-}" ] || continue
		matched=yes
		for p in "$@"; do
			if ! tracks "$c" "$p" || [ "$(index_at "$p")" != "$(g rev-parse "$c:$p" 2>/dev/null)" ]; then
				matched=no
				break
			fi
		done
		if [ "$matched" = yes ]; then
			return 0
		fi
	done
	return 1
}

# ---- undo an interrupted update's own files -----------------------------
# `nr --update` writes into $HOME: the update scripts rewrite flake-pins.json and
# the overlay pins, `nix flake update` rewrites flake.lock, nr-pins renders
# flake.nix. Interrupt it and those half-written files are still there, and the
# checks below cannot tell them from hand work — so they refuse to apply main and
# the re-run quietly builds a stale tree. Put them back to main first (the
# pipeline is their only writer), then judge what is left.
#
# This lives here, not in the `nr` function, because nr executes this script by
# path on every run: it is always the applied copy, whatever age the calling
# shell's function definitions are. On 2026-11-20 a re-run skipped it because the
# shell held an older `nr`.
if [ -x "$root/bin/nr-update-recover" ]; then
	"$root/bin/nr-update-recover"
fi

# ---- apply tree: bring $HOME up to main ---------------------------------
if [ -n "$(g status --porcelain --untracked-files=no 2>/dev/null)" ]; then
	# Paths an apply would change: compare the work tree with main, ignoring the
	# index (the two checkouts share history, not one). A path missing from $HOME
	# has no local content to lose.
	present=()
	for p in $(g diff --name-only main 2>/dev/null); do
		if [ -e "$root/$p" ]; then
			present[${#present[@]}]=$p
		fi
	done

	# Applying is safe only while EVERY present path holds an OLDER committed
	# state. Per path, not as a group: a checkout several commits behind may match
	# no single position, and testing the set would call that local work.
	# Anything a path cannot explain is local work.
	stale=yes
	for p in ${present[@]+"${present[@]}"}; do
		if ! find_position "$p" >/dev/null; then
			stale=no
			break
		fi
	done

	if [ "$stale" = yes ]; then
		# `:/` is anchored at the top of the work tree, so this works from any
		# cwd; a bare `.` would resolve against the caller's.
		printf 'nr: applying %s to %s\n' "$(g rev-parse --short main)" "$root"
		log=${TMPDIR:-/tmp}/nr-guard-apply.$$
		# Not `checkout main -- ':/'`: that writes only the paths main has, so a
		# path main DELETED survives in the index and on disk. $HOME then looks
		# locally edited to every later run, which refuses to apply -- and the
		# dropped file stays built into the tree. `read-tree -u --reset` is the
		# primitive that makes index+work tree EQUAL main: it removes what main
		# no longer has and leaves untracked files alone. Safe here because the
		# loop above proved every differing path holds an older committed state.
		if g read-tree -u --reset main >"$log" 2>&1; then
			rm -f "$log"
		else
			printf 'nr: ERROR could not apply main to %s -- refusing to build:\n' "$root" >&2
			cat "$log" >&2
			rm -f "$log"
			exit 1
		fi
	else
		# Never clobber. Name the paths whose content appears nowhere in history
		# -- those are the local edits -- and build what is there: an
		# `nr --update` retry has to rebuild the uncommitted bumps it just left in
		# $HOME, so stopping here would deadlock that path.
		say 'nr: WARNING %s has local edits to tracked files -- not applying main:\n' "$root"
		shown=0
		for p in ${present[@]+"${present[@]}"}; do
			if ! find_position "$p" >/dev/null; then
				say 'nr:           %s\n' "$p"
				shown=$((shown + 1))
				[ "$shown" -lt 8 ] || break
			fi
		done
		say '%s\n' 'nr:           building what is there; to discard them: config read-tree -u --reset main'
	fi
fi

# ---- edit tree: may a commit be made from worktree/? ---------------------
if [ -d "$edit_tree" ]; then
	main=$(g rev-parse main 2>/dev/null)
	if [ -n "$(e status --porcelain --untracked-files=no 2>/dev/null)" ]; then
		# Is the tree itself sitting on an older main, with local edits on top?
		# The test is on the TREE, not the files: a file edited on top of an old
		# state differs from every position, so asking per file cannot see it.
		# HEAD's tree is what a commit would otherwise record -- if that tree is
		# an earlier position of main, the commit reverts everything main changed
		# since (4d4fb86).
		# Only a tree sitting BELOW main can revert anything. HEAD on main itself
		# (a plain local edit on top of current main) is ordinary work, even
		# though some sibling commit may share that tree -- two commits can.
		# This branch covers an edit checkout that has a branch of its own: its
		# HEAD stays below main when $HOME-side commits move main.
		wt_stale=no
		wt_head=$(e rev-parse HEAD 2>/dev/null)
		if [ -n "$wt_head" ] && [ "$wt_head" != "$main" ]; then
			head_tree=$(e rev-parse "$wt_head^{tree}" 2>/dev/null)
			for c in $(positions); do
				[ "$c" != "$main" ] || continue
				if [ -n "$head_tree" ] && [ "$(g rev-parse "$c^{tree}" 2>/dev/null)" = "$head_tree" ]; then
					wt_stale=yes
					break
				fi
			done
		fi
		# The real accismus layout has no branch of its own: the edit checkout
		# shares main's ref, so a $HOME-side commit moved HEAD too and the check
		# above cannot see anything. What did stay put is the INDEX, still
		# describing the previous main; git shows that as staged reverts. With no
		# unstaged edits, ask whether every staged blob is an older main.
		if [ "$wt_stale" = no ] && [ -n "$wt_head" ] && [ "$wt_head" = "$main" ] &&
			e diff --quiet 2>/dev/null; then
			staged=$(e diff --cached --name-only 2>/dev/null)
			if [ -n "$staged" ] && index_matches_position $staged; then
				wt_stale=yes
			fi
		fi
		if [ "$wt_stale" = yes ]; then
			# Sync it rather than printing a task to remember, but only in the one
			# shape nr itself creates: HEAD already at main (the edit tree shares
			# main's ref) while its files and index still describe an earlier one.
			# That holds no work — every entry matches an earlier main — so nothing
			# is lost, and `nr --update`'s commit step moves main on every successful
			# run, which is why this note was chronic. A tree on an older HEAD, or
			# one with an unstaged edit, keeps the advice: those can hold content
			# that matches no main (see case 5a in the tests).
			if [ "$wt_head" = "$main" ] && e diff --quiet 2>/dev/null &&
				e reset -q --hard main >/dev/null 2>&1; then
				say 'nr: note: worktree/ (edit tree) is only STALE -- its files/index match an earlier main; synced to %s\n' "$(e rev-parse --short main)"
			else
				say '%s\n' 'nr: note: worktree/ (edit tree) is only STALE -- its files/index match an earlier main.'
				say '%s\n' 'nr:       do not commit there (that reverts the $HOME-side commit); sync:'
				say 'nr:       git -C %s reset --hard main\n' "$edit_tree"
			fi
		else
			say '%s\n' 'nr: note: worktree/ (edit tree) has uncommitted changes -- this run does not use it'
			say '%s\n' "nr:       commit or stash them before you next edit there (a plain 'reset --hard main' would discard them)"
		fi
	else
		wt_head=$(e rev-parse HEAD 2>/dev/null)
		if [ -n "$wt_head" ] && [ -n "$main" ] && [ "$wt_head" != "$main" ]; then
			say '%s\n' 'nr: note: worktree/ (edit tree) is behind main -- sync it:'
			say 'nr:       git -C %s pull --ff-only\n' "$edit_tree"
		fi
	fi
fi

# The verdict. Without it the last line of a warning block reads as a stop sign,
# which is how a run gets cancelled for no reason.
[ "$announced" = yes ] && printf '%s\n' 'nr: continuing -- nothing above blocks this build' >&2

exit 0
