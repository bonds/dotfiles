# Managed by nix activation scripts (symlink to ~/.config/ssh/keys)
.ssh/authorized_keys

# ─────────────────────────────────────────────────────────────────────────
# This repo is PUBLIC and its work tree is $HOME, so anything staged here is
# published. Untracked files are hidden from `git status` by default
# (status.showUntrackedFiles=no), which means a stray `config add -A` is the
# only way secrets leak — these patterns are the last line of defence.
#
# Verify with: gitleaks detect --no-git --source . -c .config/nix/.gitleaks.toml
# (also runs as the `secrets-check` flake check).
# ─────────────────────────────────────────────────────────────────────────

# ── Credentials and personal data: never commit ──────────────────────────
# gcloud: access_tokens.db, credentials.db, legacy_credentials/*/adc.json
.config/gcloud/
# ChatGPT desktop app: conversations.json is personal data
.config/chatgpt/
# age-plugin-yubikey identity (hardware-wrapped, but not for a public repo);
# the passage identities that ARE tracked live in .config/passage/
.config/age/
# polyptych: .env holds AMO_JWT_SECRET
.config/polyptych/
# gh: hosts.yml gains an oauth_token whenever the keyring is unavailable
.config/gh/hosts.yml

# ── Machine state and caches: recreated by the apps ──────────────────────
.DS_Store
**/*.log
.config/browser-harness/
.config/cmux/
.config/configstore/
.config/ghosttile/
.config/inkscape/
# fish: fisher regenerates its plugins from the tracked .config/fish/fish_plugins;
# hand-written functions (movie.fish, killmovie.fish) ARE tracked on purpose.
# Completions are listed per-file, not as a directory, so a hand-written one
# cannot be silently ignored the way a blanket .config/fish/completions/ would.
.config/fish/fish_variables
.config/fish/completions/fisher.fish
.config/fish/completions/fzf_configure_bindings.fish
.config/fish/conf.d/fzf.fish
.config/fish/functions/_fzf_*
.config/fish/functions/fisher.fish
.config/fish/functions/fzf_configure_bindings.fish
# angband: save/lore state, not config
.config/angband/CharOutput.txt
.config/angband/lore.txt

# openspec: telemetry anonymousId is per-machine state, not config
.config/openspec/
# cabal: generated by cabal itself (~240 lines of defaults) with absolute
# /Users/scott paths; only `nix: disable` and `remote-build-reporting: none`
# are real choices, and a tracked copy would push macOS paths onto the Linux
# hosts. Nothing in nix manages this file — cabal must be able to write it.
.config/cabal/
